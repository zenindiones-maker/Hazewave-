---
import {verifiedSiteAssets} from "../../scripts/artcraft-build-gate.mjs";
// WAVE authority is unchanged: site builds require the exact seven-Craft
// provenance bundle, but synthetic lab imagery is NEVER presented as owner art.
const evidence = verifiedSiteAssets();
const acts = [
  "O silêncio tem uma superfície.",
  "Uma frequência encontra o vazio.",
  "A tinta aprende a vibrar.",
  "O som encontra resistência.",
  "A névoa guarda uma memória.",
  "A interferência redesenha a matéria.",
  "O universo reconhece uma assinatura.",
];
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="theme-color" content="#080712" />
  <meta name="description" content="HAZEWAVE Site 01 — o movimento de rolagem cria, linha a linha, um universo de interferência sonora." />
  <title>HAZEWAVE — A frequência que desenha o universo · Indionesbala</title>
  <style>
  :root{color-scheme:dark;background:#080711;color:#fff0e7;font-family:ui-sans-serif,system-ui,sans-serif}
  *{box-sizing:border-box}
  html{scroll-behavior:auto;overflow-x:clip}
  body{margin:0;min-width:320px;overflow-x:clip;background:#080711;color:#fff0e7}
  a{color:inherit}
  a:focus-visible{outline:2px solid #efb679;outline-offset:6px}
  .visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .skip{position:fixed;left:15px;top:-90px;z-index:100;padding:13px 18px;background:#fff3e8;color:#090615;text-decoration:none}
  .skip:focus{top:10px}
  #ink-journey{height:840svh;position:relative;isolation:isolate}
  #ink-stage{position:sticky;top:0;left:0;height:100svh;min-height:420px;width:100%;overflow:hidden;isolation:isolate;background:radial-gradient(ellipse 45% 42% at 51% 45%,#1f1230 0%,#0e0a20 54%,#05050c 100%);}
  #ink-stage:before{content:"";position:absolute;inset:0;pointer-events:none;z-index:1;background-image:radial-gradient(circle at 22% 17%,#fff5e6a8 .6px,transparent 1.6px),radial-gradient(circle at 82% 71%,#ecabff8a .7px,transparent 1.7px),radial-gradient(circle at 57% 91%,#ffcc8c88 1px,transparent 2px);background-size:317px 311px,479px 431px,563px 607px;opacity:.23;}
  #ink-stage:after{content:"";position:absolute;inset:0;z-index:8;pointer-events:none;background:radial-gradient(ellipse 55% 58% at 50% 50%,transparent 34%,#04030b99 100%)}
  .site01-title{position:absolute;z-index:20;top:clamp(14px,3svh,35px);left:50%;transform:translateX(-50%);margin:0;white-space:nowrap;letter-spacing:.12em;font:italic 500 clamp(25px,6.5vw,68px)/1.05 Georgia,serif;text-shadow:0 0 22px #a158e38c,0 4px 35px #000}
  .site01-kicker{position:absolute;z-index:20;top:clamp(63px,10svh,120px);left:50%;transform:translateX(-50%);color:#c8b5d7;font-size:clamp(9px,1.25vw,12px);letter-spacing:.19em;text-transform:uppercase;white-space:nowrap}
  #ink-story-engine{position:absolute;z-index:3;inset:0;margin:auto;height:100%;width:min(100%,1120px);overflow:visible;pointer-events:none;transform:translate3d(0,var(--camera-y,0px),0) scale(var(--camera-z,1));transform-origin:50% 48%;will-change:transform}
  .ink-line{stroke-linecap:round;stroke-linejoin:round;fill:none;vector-effect:non-scaling-stroke}
  .ink-primary{stroke:#d5a0ff;stroke-width:3.6;filter:drop-shadow(0 0 4px #a34fff99)}
  .ink-secondary{stroke:#efb689;stroke-width:1.8}
  .ink-scar{stroke:#ecc7e9;stroke-width:1.35}
  .ink-galaxy{stroke:#a77eea;stroke-width:2.2;filter:drop-shadow(0 0 7px #9161e960)}
  .ink-constellation{stroke:#fff0e1;stroke-width:1.25}
  .ink-body{stroke:#f3baca;stroke-width:3.1;filter:drop-shadow(0 0 7px #ea94dc55)}
  #ink-seed{fill:#fff7ee;filter:drop-shadow(0 0 13px #cf83ff);opacity:0}
  #ink-bleed{opacity:var(--bleed,.13)}
  #ink-revealed-original{opacity:.93}
  .site01-brand{position:absolute;z-index:17;left:50%;top:16%;transform:translateX(-50%);width:min(83vw,740px);max-height:23svh;aspect-ratio:1024/475;overflow:hidden;opacity:var(--brand-visibility,0);clip-path:inset(0 var(--brand-clip,100%) 0 0);filter:drop-shadow(0 0 28px #b16ffa70);pointer-events:none}
  .site01-brand img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top;-webkit-mask-image:linear-gradient(to bottom,#000 72%,transparent 100%);mask-image:linear-gradient(to bottom,#000 72%,transparent 100%)}
  .site01-artist-mark{position:absolute;z-index:20;bottom:clamp(76px,14svh,145px);left:50%;transform:translateX(-50%);width:min(17vw,135px);max-height:54px;opacity:.7;overflow:hidden;clip-path:inset(0 var(--signature-clip,100%) 0 0);mix-blend-mode:screen;pointer-events:none}
  .site01-artist-mark img{display:block;width:100%;height:auto;max-height:54px;object-fit:contain}
  .ink-caption-wrap{position:absolute;z-index:18;left:50%;bottom:clamp(135px,21svh,210px);transform:translateX(-50%);width:min(88vw,540px);text-align:center;pointer-events:none}
  .ink-caption{margin:0;font:italic 400 clamp(24px,5.5vw,56px)/1.12 Georgia,serif;letter-spacing:-.028em;color:#fff1ec;text-wrap:balance;text-shadow:0 10px 42px #09050fe8}
  .ink-instruction{position:absolute;z-index:18;bottom:clamp(29px,6svh,59px);left:50%;transform:translateX(-50%);display:flex;gap:12px;align-items:center;color:#e4ced9;font-size:clamp(10px,1.8vw,12px);letter-spacing:.10em;white-space:nowrap;text-transform:uppercase}
  .ink-instruction .arrow{font-family:Georgia,serif;font-size:23px;font-weight:400}
  .site01-footer{position:relative;min-height:100svh;display:grid;place-items:center;padding:120px 22px 100px;background:radial-gradient(ellipse 55% 43% at 52% 32%,#331a4769,transparent),#080711;text-align:center}
  .site01-footer h2{font:italic 400 clamp(43px,10vw,105px)/.98 Georgia,serif;margin:15px 0 16px;color:#fff0ea}
  .site01-footer p{max-width:540px;color:#d6bed9;line-height:1.65;font-size:clamp(15px,2vw,19px);margin:0 auto 34px}
  .site01-footer a{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:15px 25px;border:1px solid #e5aef3a3;border-radius:99px;text-decoration:none;font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:#221432}
  .site01-footer a:hover,.site01-footer a:focus-visible{background:#51285e}
  .site01-footer .endmark{font:italic 500 clamp(32px,8vw,82px) Georgia,serif;letter-spacing:.08em}
  #ink-arrival-link{opacity:var(--arrival,0);pointer-events:none}
  body[data-ink-state="arrival"] #ink-arrival-link{pointer-events:auto}
  #ink-noscript{background:#170f26;color:#fff;padding:22px;text-align:center}
  #ink-noscript a{text-decoration:underline}
  @media (max-width:700px){
    #ink-stage{background:radial-gradient(ellipse 85% 45% at 49% 44%,#231334 0%,#0b091a 68%,#05040d)}
    #ink-story-engine{width:100%;height:90%;top:7%;transform:translate3d(0,var(--camera-y,0px),0) scale(var(--camera-z,1));}
    .site01-title{font-size:clamp(28px,9vw,43px)}
    .site01-kicker{top:11svh;font-size:9px;letter-spacing:.14em}
    .site01-brand{top:21%;width:90vw;max-height:20svh}
    .site01-artist-mark{width:min(17vw,105px);bottom:12svh}
    .ink-caption-wrap{bottom:21svh;width:88vw}
    .ink-caption{font-size:clamp(25px,7.6vw,38px)}
    .ink-primary,.ink-body{filter:none}
  }
  @media(prefers-reduced-motion:reduce){
    #ink-story-engine{will-change:auto;transform:none!important}
    .ink-primary,.ink-galaxy,.ink-body{filter:none}
    .site01-footer a{transition:none}
  }
  </style>
</head>
<body data-experience="hazewave-site-01-ink" data-ink-state="silence" data-ink-progress="0">
<a class="skip" href="#site01-destination">Pular experiência e abrir artista</a>
<main>
  <section id="ink-journey" aria-label="Uma travessia desenhada pelo scroll">
    <div id="ink-stage">
      <h1 class="site01-title">HAZEWAVE</h1>
      <span class="site01-kicker">O som desenha o impossível</span>
      <div class="site01-brand" aria-hidden="true"><img src="/media/hazewave-world.jpg" alt="HAZEWAVE" width="1024" height="475" /></div>
      <svg id="ink-story-engine" data-renderer="svg-stroke" viewBox="0 0 1000 1500" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" data-artcraft-sha={evidence.manifest.head_sha}>
        <defs>
          <mask id="brush-owner-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1000" height="1500">
            <rect x="0" y="0" width="1000" height="1500" fill="black"/>
            <path data-ink-stroke="owner-mask" data-start=".69" data-end=".92"
              d="M226 520 C358 488 460 541 620 501 S818 524 774 581 S590 610 431 585 S234 642 232 658 S580 665 777 644"
              stroke="white" stroke-width="155" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
          </mask>
          <linearGradient id="ink-violet" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#e9cbff"/><stop offset="52%" stop-color="#a66fff"/><stop offset="100%" stop-color="#ffb77c"/>
          </linearGradient>
        </defs>
        <g id="ink-bleed" opacity=".20">
          <path data-ink-stroke="sparks" data-start=".61" data-end=".85" class="ink-line ink-scar" stroke-width="14"
            d="M237 413 L248 396 M791 577 L817 558 M319 902 L294 936 M765 984 L789 1015 M478 275 L493 247 M678 356 L695 337 M211 663 L195 688"/>
        </g>
        <circle id="ink-seed" cx="492" cy="1197" r="4"/>
        <g id="ink-trajectory">
          <path class="ink-line ink-primary" data-ink-stroke="origin" data-start=".012" data-end=".16"
            d="M492 1197 C477 1168 487 1146 463 1124 S392 1079 421 1038 S536 1023 543 986 S460 953 475 920 S612 923 650 858 S684 790 604 757"/>
          <path class="ink-line ink-secondary" data-ink-stroke="current" data-start=".13" data-end=".28"
            d="M604 757 C552 734 469 753 454 706 S500 646 546 665 S636 744 666 692 S630 582 574 590 S510 657 439 633 S326 549 293 557"/>
          <path class="ink-line ink-primary" data-ink-stroke="wave" data-start=".20" data-end=".34"
            d="M293 557 C238 563 210 639 174 612 S220 490 301 477 S364 548 440 504 S573 423 606 475 S670 564 758 500 S841 407 883 440"/>
          <path class="ink-line ink-scar" data-ink-stroke="interference" data-start=".285" data-end=".43"
            d="M297 558 C355 596 389 504 439 519 S502 622 546 603 S598 510 651 532 S736 614 801 551"/>
          <path class="ink-line ink-secondary" data-ink-stroke="echo" data-start=".32" data-end=".48"
            d="M240 614 C317 648 399 569 441 604 S499 681 578 640 S683 616 765 656 M236 674 C340 713 390 662 445 706 S573 731 633 695 S727 734 816 700"/>
          <path class="ink-line ink-scar" data-ink-stroke="fracture" data-start=".39" data-end=".54"
            d="M584 650 C565 629 579 596 601 579 S646 563 649 529 M585 646 C613 660 649 655 668 632 S713 622 738 642 M572 652 C550 671 531 721 546 755 S571 821 534 842"/>
          <path class="ink-line ink-galaxy" data-ink-stroke="nebula" data-start=".43" data-end=".64"
            d="M287 471 C374 366 515 397 549 426 S608 504 523 551 S354 600 342 504 S398 365 519 356 S718 427 702 524 S585 659 475 651 S285 599 261 497"/>
          <path class="ink-line ink-galaxy" data-ink-stroke="nebula2" data-start=".49" data-end=".67"
            d="M247 478 C220 418 284 315 377 296 S571 308 650 344 S822 487 801 602 S689 784 533 785 S254 707 195 576 S226 373 302 336"/>
          <path class="ink-line ink-constellation" data-ink-stroke="constellation" data-start=".53" data-end=".73"
            d="M270 345 L322 286 L399 320 L480 248 L544 295 L649 266 L728 361 L823 398 M213 798 L290 760 L367 816 L474 793 L566 886 L657 832 L769 901"/>
          <path class="ink-line ink-galaxy" data-ink-stroke="orbit" data-start=".60" data-end=".77"
            d="M164 715 C130 519 275 283 494 272 C724 257 875 468 839 679 C801 886 596 1002 395 936 C226 883 134 753 164 604"/>
          <path class="ink-line ink-secondary" data-ink-stroke="halo" data-start=".66" data-end=".82"
            d="M323 515 C294 429 390 359 503 357 S709 439 696 542 S564 699 452 663 S314 568 356 491 S493 411 554 462 S569 570 490 574 S423 500 478 478"/>
          <path class="ink-line ink-body" data-ink-stroke="weave" data-start=".70" data-end=".86"
            d="M165 967 C291 844 397 970 512 890 S748 812 862 928 S786 1044 697 1016 S510 1015 438 1075 S285 1171 166 1089"/>
          <path class="ink-line ink-constellation" data-ink-stroke="identity" data-start=".76" data-end=".925"
            d="M236 438 C342 407 419 436 494 422 S683 394 771 436 M222 716 C361 763 456 728 528 749 S706 785 793 726"/>
          <path class="ink-line ink-secondary" data-ink-stroke="signature" data-start=".89" data-end=".985"
            d="M322 1115 C417 1084 441 1043 507 1040 S607 1097 661 1084 S739 1058 764 1076 C728 1120 649 1150 572 1145 S411 1134 345 1180"/>
        </g>
        <image id="ink-revealed-original" href="/media/hazewave-world.jpg" x="206" y="452" width="588" height="280" preserveAspectRatio="xMidYMin slice" mask="url(#brush-owner-mask)" />
      </svg>
      <div class="ink-caption-wrap"><p id="ink-caption" class="ink-caption" aria-live="polite" aria-atomic="true">{acts[0]}</p></div>
      <div class="site01-artist-mark" aria-hidden="true"><img src="/media/artists/indionesbala.jpg" alt="Indionesbala" width="1536" height="643" /></div>
      <div class="ink-instruction"><span>Role para desenhar · suba para apagar</span><span class="arrow" aria-hidden="true">↓</span></div>
      <div id="ink-chapters" hidden>{acts.map((label,index)=><span data-ink-chapter={index} data-verse={label}></span>)}</div>
      <noscript><div id="ink-noscript">A experiência ilustrada necessita de JavaScript. <a href="/artists/indionesbala/">Conhecer Indionesbala</a>.</div></noscript>
    </div>
  </section>
  <section id="site01-destination" class="site01-footer" aria-labelledby="site01-destination-title">
    <div>
      <span class="endmark">HAZEWAVE</span>
      <h2 id="site01-destination-title">O mundo responde<br/>à frequência.</h2>
      <p>Uma linha cria o caminho. A interferência desenha o universo. Indionesbala abre a próxima travessia.</p>
      <a id="ink-arrival-link" href="/artists/indionesbala/">Entrar no universo de Indionesbala <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</main>
<script>
  import { mountSite01Ink } from "../experience/site01-ink";
  mountSite01Ink();
</script>
</body>
</html>
