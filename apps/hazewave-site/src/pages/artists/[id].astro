---
import "../../styles/illustrated-interference.css";
import { PUBLIC_ARTISTS, type PublicArtist } from "../../data/publicArtists";
export function getStaticPaths() {
  return PUBLIC_ARTISTS.map((artist) => ({ params: { id: artist.slug }, props: { artist } }));
}
const { artist } = Astro.props as { artist: PublicArtist };
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="theme-color" content="#090e18"/>
  <meta name="description" content={"Hazewave — universo musical e arte original de "+artist.name}/>
  <title>{artist.name} — Universo Hazewave</title>
</head>
<body class="constellation-detail">
  <a class="skip" href="#artist-world">Ir para o artista</a>
  <header class="masthead">
    <a class="masthead-mark" href="/#beginning" aria-label="Voltar ao universo Hazewave">HAZE<span>WAVE</span><i aria-hidden="true">∿</i></a>
    <span class="masthead-edition">UM MUNDO · MUITAS FREQUÊNCIAS</span>
    <a class="masthead-link" href="/#worlds">VOLTAR À CONSTELAÇÃO ↗</a>
  </header>
  <main id="artist-world" class="artist-world">
    <div class="artist-world-ink" aria-hidden="true">
      <span class="world-ring world-ring-a"></span>
      <span class="world-ring world-ring-b"></span>
      <span class="world-ring world-ring-c"></span>
      <span class="world-thread"></span>
    </div>
    <div class="artist-world-art">
      <div class="artist-world-orb">
        <img src={artist.image} alt={"Arte original de "+artist.name} width="600" height="600"/>
      </div>
      <span class="eyebrow">ARTE ORIGINAL DO ARTISTA · PRESERVADA</span>
    </div>
    <div class="artist-world-type">
      <span class="eyebrow">HAZEWAVE / CONSTELAÇÃO</span>
      <h1>{artist.name}</h1>
      <p>Um mundo singular na galáxia Hazewave. Aqui, a arte original é o ponto de partida — sem músicas, biografias ou lançamentos inventados.</p>
      <a class="world-return" href="/#worlds">EXPLORAR OUTROS MUNDOS <span aria-hidden="true">↗</span></a>
    </div>
  </main>
  <nav class="world-switcher" aria-label="Outros mundos">
    {PUBLIC_ARTISTS.map((entry, index) => (
      <a href={"/artists/"+entry.slug+"/"} aria-current={entry.slug===artist.slug?"page":undefined}><span>0{index+1}</span>{entry.name}</a>
    ))}
  </nav>
  <footer class="colophon"><span>HAZEWAVE — CADA ARTISTA, UM UNIVERSO</span><a href="/#beginning">INÍCIO ↑</a></footer>
</body>
</html>