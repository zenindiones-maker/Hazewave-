---
import "../styles/living-field.css";
import { realArtists } from "../data/realArtists";
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#070908" />
    <meta name="description" content="Hazewave. Núcleo Sonoro Independente, Santos. Atravesse a névoa e encontre o universo de cada artista." />
    <meta property="og:title" content="Hazewave — Living Resonance Field" />
    <meta property="og:image" content="/media/hazewave-world.jpg" />
    <meta property="og:type" content="website" />
    <link rel="preload" as="image" href="/media/hazewave-world.jpg" fetchpriority="high" />
    <title>Hazewave — Living Resonance Field</title>
  </head>
  <body>
    <main id="living-field" class="living-field" data-field-runtime="initializing" data-world-active="false" data-wave-active="false" data-world-ready="true" aria-label="Hazewave Living Resonance Field">
      <div class="field-origin" aria-hidden="true">
        <img id="hazewave-world-source" src="/media/hazewave-world.jpg" alt="" fetchpriority="high" />
      </div>
      <canvas id="living-field-canvas" aria-hidden="true"></canvas>
      <div class="field-grain" aria-hidden="true"></div>
      <header class="field-header">
        <div class="field-brand"><h1 class="sr-only">HAZEWAVE</h1><svg class="hazewave-lettering" viewBox="70 62 884 410" aria-hidden="true"><defs><filter id="owner-lettering-mask"><feColorMatrix in="SourceGraphic" type="luminanceToAlpha" result="luminance"/><feComponentTransfer in="luminance" result="lettering"><feFuncA type="linear" slope="4" intercept="-2.5"/></feComponentTransfer><feComposite in="SourceGraphic" in2="lettering" operator="in"/></filter></defs><image href="/media/hazewave-world.jpg" width="1024" height="1536" filter="url(#owner-lettering-mask)" /></svg><p>Núcleo Sonoro Independente <span>· Santos</span></p></div>
        <button id="motion-toggle" class="motion-toggle" type="button" aria-pressed="false"><span aria-hidden="true">Ⅱ</span> <span>Pausar movimento</span></button>
        <button id="world-back" class="world-back" type="button" hidden>← <span>VOLTAR AO CAMPO</span></button>
      </header>
      <nav class="primary-paths" aria-label="Caminhos principais">
        <button type="button" data-primary-action="explore" class="primary-explore"><span class="nav-number">01</span> EXPLORE <span class="nav-arrow" aria-hidden="true">↗</span></button>
        <button type="button" data-primary-action="listen"><span class="nav-number">02</span> LISTEN</button>
        <button type="button" data-primary-action="search"><span class="nav-number">03</span> SEARCH <span class="search-icon" aria-hidden="true"></span></button>
      </nav>
      <div class="field-intro" aria-hidden="true"><span class="eyebrow">LIVING RESONANCE FIELD</span></div>
      <div class="signal-field" aria-label="Sinais de artistas">
        {realArtists.map((artist, index) => <button type="button" class="artist-signal" data-artist-signal={artist.id} data-materialized={String(artist.materializedWorld)} aria-label={`Entrar no sinal de ${artist.name}`} style={`--signal-color:${artist.color}`}>
          <span class="signal-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
          <span class="signal-label"><small>0{index + 1}</small><strong>{artist.name}</strong><b aria-hidden="true">{artist.id === "aquaverno" && <span class="signal-discover">descobrir ↗</span>}<span class="signal-enter">ENTRAR ↗</span></b></span>
          <span class="signal-preview" aria-hidden="true"><img src={artist.artwork!} alt="" loading="lazy" /><span>ENTRAR NO MUNDO ↗</span></span>
        </button>)}
      </div>
      <div class="field-invitation"><span class="touch-mark" aria-hidden="true">+</span><p>Atravesse a névoa.<br /><span>Toque para descobrir um artista.</span></p></div>
      <div class="journey-controls" hidden><div class="journey-copy"><strong id="journey-artist">Aquaverno</strong><span id="journey-stage">01 / ENCONTRE O SINAL</span></div><span class="journey-track"><i></i></span><button type="button" id="journey-exit">SAIR DA TRAVESSIA ×</button></div>
      <div class="field-index" aria-hidden="true"><span>05 SINAIS</span><span class="index-line"></span><span>UM CAMPO ABERTO</span></div>
      <p id="world-art-error" role="status">A arte deste sinal está indisponível. Explore outro artista.</p>
      <div class="artist-world-shell">
        {realArtists.map((artist, index) => <section class="artist-world" data-artist-world={artist.id} data-world-system={artist.worldSystem} data-active="false" aria-label={`Mundo visual de ${artist.name}`} inert>
          <img class="world-fallback-art" src={artist.artwork!} alt={artist.artworkAlt} decoding="async" loading="lazy" />
          <div class="world-caption"><span class="eyebrow">HAZEWAVE / 0{index + 1}</span><h2 class="sr-only">{artist.name}</h2>{artist.id === "aquaverno" && <svg class="aquaverno-lettering" viewBox="55 28 1426 305" aria-hidden="true"><image href="/media/artists/aquaverno.jpg" width="1536" height="1536" /></svg>}</div>
          <div class="world-arrival-actions"><button type="button" class="world-listen" data-world-listen><span>OUVIR <b aria-hidden="true">↗</b></span><small>Faixas em preparação</small></button><button type="button" class="world-switch" data-world-switch>EXPLORAR OUTRO SINAL <span aria-hidden="true">↗</span></button></div>
        </section>)}
      </div>
      <section id="persistent-transport" class="persistent-transport" tabindex="-1" aria-label="Player Hazewave" data-expanded="false">
        <span class="transport-symbol" aria-hidden="true">≋</span>
        <div class="transport-copy"><strong id="transport-artist">HAZEWAVE</strong><span id="transport-state">Músicas em preparação</span></div>
        <div class="transport-controls" aria-label="Controles de reprodução">
          <button type="button" aria-label="Anterior" disabled>Ⅰ‹</button><button type="button" class="play-control" aria-label="Tocar" disabled>▷</button><button type="button" aria-label="Próxima" disabled>›Ⅰ</button>
        </div>
        <label class="transport-seek"><span class="sr-only">Posição da faixa</span><input type="range" min="0" max="100" value="0" disabled aria-label="Posição da faixa" /></label>
        <label class="transport-volume"><span class="sr-only">Volume</span><span aria-hidden="true">◖</span><input type="range" min="0" max="100" value="70" disabled aria-label="Volume" /></label>
        <button type="button" id="transport-close" aria-label="Recolher player" hidden>×</button>
      </section>
      <p id="field-status" class="sr-only" role="status" aria-live="polite">Explore os cinco artistas pelo campo ou pela busca.</p>
      <dialog id="artist-search" class="artist-search" aria-label="Buscar artista">
        <header class="search-head"><span class="eyebrow">ENCONTRE SEU PRÓXIMO UNIVERSO</span><button type="button" data-search-close aria-label="Fechar busca">×</button></header>
        <label class="search-input-label"><span class="sr-only">Nome do artista</span><input id="artist-query" type="search" placeholder="Qual sinal você procura?" autocomplete="off" /></label>
        <div class="search-list">{realArtists.map((artist, index) => <button type="button" data-search-artist={artist.id}><span class="search-art"><img src={artist.artwork!} alt="" loading="lazy" /></span><span>{artist.name}</span><small>0{index + 1}</small><b aria-hidden="true">↗</b></button>)}</div>
        <p id="search-empty" hidden>Nenhum artista encontrado. Tente outro nome.</p>
      </dialog>
      <noscript>
        <section class="static-gallery" aria-label="Artistas Hazewave">
          <h2>Hazewave · Núcleo Sonoro Independente</h2><p>Explore as artes dos nossos artistas. Ative JavaScript para atravessar o campo interativo.</p>
          <figure><img src="/media/hazewave-world.jpg" alt="Universo Hazewave: farol entre ondas e um vórtice verde e roxo" /><figcaption>HAZEWAVE — Santos</figcaption></figure>
          {realArtists.map(artist=><figure><a href={artist.artwork!}><img src={artist.artwork!} alt={artist.artworkAlt} /></a><figcaption>{artist.name}</figcaption></figure>)}
        </section>
        <style>.living-field::after{display:none}.living-field{height:auto;overflow:visible}.field-origin,#living-field-canvas,.field-header,.field-intro,.primary-paths,.signal-field,.artist-world-shell,.field-invitation,.field-index,.persistent-transport,#world-art-error{display:none}.static-gallery{padding:28px;max-width:800px;margin:auto}.static-gallery figure{margin:35px 0}.static-gallery img{max-width:100%;max-height:80svh;object-fit:contain}.static-gallery p{line-height:1.6}</style>
      </noscript>
    </main>
    <div id="journey-distance" aria-hidden="true" hidden></div>
    <script>import { bootLivingField } from "../experience/livingField"; bootLivingField();</script>
  </body>
</html>
