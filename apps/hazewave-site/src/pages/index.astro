---
import "../styles/illustrated-interference.css";
import { PUBLIC_ARTISTS } from "../data/publicArtists";
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#090e18" />
  <meta name="description" content="Hazewave — uma história ilustrada sobre a onda de interferência que atravessa a névoa do universo e conecta mundos musicais." />
  <title>HAZEWAVE — Uma onda, muitos universos</title>
</head>
<body class="story-mode" data-phase="origin" data-motion="full">
  <a class="skip" href="#worlds">Pular para os artistas</a>
  <header class="masthead">
    <a href="#beginning" class="masthead-mark" aria-label="HAZEWAVE, voltar ao início">HAZE<span>WAVE</span><i aria-hidden="true">∿</i></a>
    <span class="masthead-edition">UM ROMANCE VISUAL SOBRE O SOM</span>
    <a href="#worlds" class="masthead-link">OS MUNDOS <span aria-hidden="true">↗</span></a>
  </header>

  <main>
    <section id="film" class="film" aria-label="A jornada da interferência sonora">
      <div class="film-reel" id="beginning">
        <div class="illustrated-sky" aria-hidden="true">
          <div class="night-horizon"></div>
          <svg id="interference-art" class="interference-art" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" role="presentation">
            <defs>
              <linearGradient id="nightInk" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#050a16"/><stop offset=".48" stop-color="#101e2b"/><stop offset="1" stop-color="#060a16"/></linearGradient>
              <linearGradient id="silk" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#d6f0de"/><stop offset=".35" stop-color="#9cc4c5"/><stop offset=".72" stop-color="#427c99"/><stop offset="1" stop-color="#181f42"/></linearGradient>
              <linearGradient id="aurora" x1="0" y1="0" x2="1" y2=".1"><stop stop-color="#b0ded6" stop-opacity="0"/><stop offset=".36" stop-color="#a4c5b4"/><stop offset=".6" stop-color="#ead3a8"/><stop offset="1" stop-color="#b0ded6" stop-opacity="0"/></linearGradient>
              <radialGradient id="halo"><stop stop-color="#ffe6ba" stop-opacity=".88"/><stop offset=".23" stop-color="#a7bbd2" stop-opacity=".39"/><stop offset="1" stop-color="#101a38" stop-opacity="0"/></radialGradient>
              <filter id="fog-ink" x="-30%" y="-40%" width="160%" height="180%">
                <feTurbulence type="fractalNoise" baseFrequency=".009 .021" numOctaves="3" seed="8" result="grain"/>
                <feDisplacementMap in="SourceGraphic" in2="grain" scale="54" xChannelSelector="R" yChannelSelector="G"/>
                <feGaussianBlur stdDeviation="5"/>
              </filter>
              <filter id="paper"><feTurbulence type="fractalNoise" baseFrequency=".31" numOctaves="2" seed="12" result="noise"/><feColorMatrix in="noise" type="saturate" values="0"/><feComponentTransfer><feFuncA type="linear" slope=".06"/></feComponentTransfer></filter>
              <clipPath id="crescent"><path d="M 720 70 C 965 40 1170 215 1160 447 C 1151 690 969 824 744 819 C 899 747 978 612 983 449 C 991 245 875 130 720 70 Z"/></clipPath>
            </defs>

            <rect width="1440" height="900" fill="url(#nightInk)"/>
            <g class="universe-stars" fill="#d5e7ec">
              <circle cx="85" cy="92" r="1.3"/><circle cx="380" cy="54" r="1.4"/><circle cx="720" cy="112" r="1.1"/>
              <circle cx="1170" cy="72" r="1.6"/><circle cx="1384" cy="194" r="2"/><circle cx="124" cy="384" r="1.3"/>
              <circle cx="1310" cy="540" r="1.5"/><circle cx="444" cy="774" r="2"/><circle cx="987" cy="718" r="1.1"/>
              <circle cx="1211" cy="830" r="1.4"/><circle cx="534" cy="291" r="1"/><circle cx="1073" cy="349" r="1.6"/>
            </g>

            <g class="ink-landscape art-origin">
              <circle cx="760" cy="429" r="255" fill="url(#halo)" opacity=".39"/>
              <path d="M0 665 C240 558 385 710 571 615 S933 586 1440 480 L1440 900 L0 900Z" fill="#131e30" opacity=".9"/>
              <path d="M-40 740 C175 643 314 836 524 713 S904 679 1480 606" fill="none" stroke="#a0bac2" stroke-width="6" opacity=".3"/>
              <path d="M-40 750 C215 681 380 848 565 738 S931 706 1480 635" fill="none" stroke="#cbd9ce" stroke-width="2" opacity=".5"/>
              <g class="seed-sound">
                <ellipse cx="709" cy="442" rx="13" ry="56" fill="#f2dfaf" opacity=".3"/>
                <path d="M705 284 Q730 371 705 444 T705 612" stroke="#fbf1d2" stroke-width="3" fill="none"/>
                <circle cx="706" cy="446" r="8" fill="#f7e6b8"/>
              </g>
            </g>

            <g class="ink-landscape art-crossing">
              <path d="M-120 722 C150 651 329 390 523 395 C752 404 833 731 1127 406 C1250 272 1391 230 1540 237 L1540 900 L-120 900Z" fill="#17304a" stroke="#e0e2ca" stroke-width="9"/>
              <path d="M-95 768 C179 669 374 467 552 480 C756 501 851 779 1142 461 C1268 323 1451 295 1540 331" fill="none" stroke="#93b8b3" stroke-width="34" opacity=".55"/>
              <path d="M-60 786 C164 733 343 549 574 564 C813 579 948 751 1204 509 C1301 416 1407 407 1500 420" fill="none" stroke="#e9cea1" stroke-width="4" opacity=".75"/>
              <path d="M-40 680 C269 499 325 208 565 236 C779 259 900 502 1092 308 C1267 136 1380 178 1490 166" fill="none" stroke="#becad0" stroke-width="90" opacity=".27" filter="url(#fog-ink)"/>
              <path d="M-140 465 C116 255 323 100 542 225 C795 378 920 184 1165 94 C1293 47 1398 88 1528 47" fill="none" stroke="#8d9daf" stroke-width="136" opacity=".2" filter="url(#fog-ink)"/>
              <g class="foam" fill="#edf0d8" opacity=".8">
                <path d="M470 398 Q536 312 597 391 Q540 364 516 419Z"/>
                <path d="M835 644 Q947 541 1050 538 Q972 601 950 650Z"/>
                <path d="M1210 351 Q1321 295 1430 322 Q1321 312 1285 365Z"/>
              </g>
            </g>

            <g class="ink-landscape art-rupture">
              <circle cx="724" cy="445" r="372" fill="url(#halo)" opacity=".87"/>
              <circle cx="720" cy="445" r="252" fill="#090f23" stroke="#d8e1cb" stroke-width="4"/>
              <circle cx="720" cy="445" r="285" fill="none" stroke="#9eacc0" stroke-width="26" opacity=".4" stroke-dasharray="390 160"/>
              <circle cx="720" cy="445" r="316" fill="none" stroke="#c3a987" stroke-width="3" opacity=".7" stroke-dasharray="470 90"/>
              <path d="M-75 498 C120 409 339 587 549 468 S1066 244 1530 438" fill="none" stroke="#e0bf93" stroke-width="43" opacity=".22" filter="url(#fog-ink)"/>
              <path d="M-75 515 C210 401 396 593 613 478 S1110 302 1530 462" fill="none" stroke="#f0e1bb" stroke-width="5" opacity=".75"/>
              <path d="M320 65 C483 138 498 273 590 311 M833 660 C989 666 1056 780 1140 887" stroke="#d9e5cc" fill="none" stroke-width="3" opacity=".7"/>
              <path d="M720 96 L720 250 M720 639 L720 795 M390 445 L470 445 M969 445 L1050 445" stroke="#e8d2a4" stroke-width="3"/>
              <path d="M555 444 Q634 302 735 447 T915 435" stroke="#dbe8d5" stroke-width="4" fill="none"/>
              <g fill="#f3e0b4"><circle cx="720" cy="96" r="6"/><circle cx="720" cy="795" r="6"/><circle cx="390" cy="445" r="5"/><circle cx="1050" cy="445" r="5"/></g>
            </g>

            <g class="signal-engraving">
              <path class="signal-shadow" pathLength="100" d="M-30 496 C143 493 191 504 280 499 L378 496 L422 454 L473 546 L522 431 L571 565 L623 405 L663 506 Q694 537 719 487 T781 478 Q881 453 952 483 L1040 493 L1475 496" fill="none" stroke="#d4c5a2" stroke-width="25" stroke-linecap="round" stroke-linejoin="round" opacity=".18"/>
              <path class="signal-core" pathLength="100" d="M-30 496 C143 493 191 504 280 499 L378 496 L422 454 L473 546 L522 431 L571 565 L623 405 L663 506 Q694 537 719 487 T781 478 Q881 453 952 483 L1040 493 L1475 496" fill="none" stroke="#fff0c5" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
              <path class="signal-echo" pathLength="100" d="M-30 504 C143 501 191 512 280 507 L378 504 L422 462 L473 554 L522 439 L571 573 L623 413 L663 514 Q694 545 719 495 T781 486 Q881 461 952 491 L1040 501 L1475 504" fill="none" stroke="#6faeba" stroke-width="2" opacity=".72"/>
            </g>
            <rect width="1440" height="900" fill="#d7e7db" filter="url(#paper)"/>
          </svg>
          <div class="vertical-filigree"></div>
          <div class="film-shade"></div>
        </div>
        <div class="film-copy">
          <article class="film-line line-origin" aria-label="Primeiro ato">
            <span class="eyebrow">01 / ANTES DA LUZ</span>
            <h1>Antes da matéria,<br/><em>uma frequência.</em></h1>
            <p>Um risco de som atravessa o vazio. E o vazio nunca mais será o mesmo.</p>
          </article>
          <article class="film-line line-crossing" aria-label="Segundo ato">
            <span class="eyebrow">02 / O PRIMEIRO IMPACTO</span>
            <h2>Ela atravessa<br/><em>o invisível.</em></h2>
            <p>A névoa se rompe, a distância dobra, as galáxias encontram outra órbita.</p>
          </article>
          <article class="film-line line-rupture" aria-label="Terceiro ato">
            <span class="eyebrow">03 / A INTERFERÊNCIA</span>
            <h2>Nenhum mundo<br/><em>fica intacto.</em></h2>
            <p>Cada som desloca um pedaço de universo. Nenhuma travessia se repete.</p>
          </article>
          <article class="film-line line-reveal" aria-label="O surgimento Hazewave">
            <span class="eyebrow">04 / A DESCOBERTA</span>
            <h2>Isso é<br/><em>HAZEWAVE.</em></h2>
            <p>Uma frequência. Muitos universos musicais.</p>
          </article>
        </div>
        <div class="identity-seal" aria-label="Arte original Hazewave preservada">
          <img src="/media/hazewave-world.jpg" alt="Arte original Hazewave, preservada sem alterações" loading="lazy" />
          <span>OBRA ORIGINAL · PRESERVADA</span>
        </div>
        <div class="film-bottom">
          <div class="progress-rail" aria-hidden="true"><span class="progress-line"></span></div>
          <span class="progress-caption">ARRASTE O TEMPO COM A ROLAGEM <b aria-hidden="true">↓</b></span>
          <a class="skip-film" href="#worlds">PULAR FILME ↗</a>
        </div>
        <span class="corner-index" aria-hidden="true">HZW — 001</span>
      </div>
    </section>

    <section id="worlds" class="worlds" aria-labelledby="worlds-title">
      <div class="worlds-entrance">
        <span class="eyebrow">05 / CONSTELAÇÃO HAZEWAVE</span>
        <h2 id="worlds-title">Uma onda.<br/><em>Cinco mundos.</em></h2>
        <p>Há universos que não cabem na mesma frequência. É por isso que a Hazewave existe.</p>
      </div>
      <div class="orbital-map" aria-label="Explore cinco universos de artistas independentes">
        <svg class="orbit-lines" viewBox="0 0 1000 1600" aria-hidden="true" preserveAspectRatio="none">
          <path d="M 500 15 C 880 190 180 432 520 715 S 900 1230 500 1585" fill="none" stroke="#b9d8d0" stroke-opacity=".34" stroke-width="2" stroke-dasharray="5 12"/>
          <circle cx="500" cy="15" r="5" fill="#e6d6b3"/><circle cx="500" cy="1585" r="5" fill="#e6d6b3"/>
        </svg>
        {PUBLIC_ARTISTS.map((artist, index) => (
          <a class={"planet planet-" + (index+1)} href={"/artists/" + artist.slug + "/"} aria-label={"Entrar no mundo de " + artist.name}>
            <span class="planet-halo">
              <img src={artist.image} alt={"Arte original de " + artist.name} loading="lazy" decoding="async"/>
            </span>
            <span class="planet-number">CONSTELAÇÃO 0{index+1}</span>
            <strong>{artist.name}</strong>
            <span class="planet-action">ENTRAR NO MUNDO <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
      <div class="worlds-outro">
        <p>Os artistas permanecem donos das suas vozes. As imagens são originais; músicas e lançamentos só serão apresentados após autorização.</p>
        <a href="#beginning">RECOMEÇAR A TRAVESSIA ↑</a>
      </div>
    </section>
  </main>
  <footer class="colophon"><span>HAZEWAVE / UMA FREQUÊNCIA SEM FRONTEIRAS</span><span>IMAGEM: WAVE · SOM: HAZE</span></footer>
  <noscript><style>.film-reel{height:100svh}.film{height:100svh}.film-line:not(.line-origin){display:none}.identity-seal{display:none}.worlds{display:block}</style></noscript>
  <script>
    import { mountStorybook } from "../experience/storybook";
    if(document.readyState === "loading") document.addEventListener("DOMContentLoaded", mountStorybook, {once:true});
    else mountStorybook();
  </script>
</body>
</html>