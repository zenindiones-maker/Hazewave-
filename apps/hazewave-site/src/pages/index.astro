---
import "../styles/cosmos.css";
import { PUBLIC_ARTISTS } from "../data/publicArtists";
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#080713" />
  <meta name="description" content="Hazewave: uma onda de interferência sonora atravessa a névoa cósmica e revela um universo de artistas independentes." />
  <title>HAZEWAVE — Uma onda atravessa o universo</title>
  <link rel="preload" href="/media/hazewave-world.jpg" as="image" />
</head>
<body data-gl="pending" data-audio="off" data-logo="hidden" data-act="birth" data-reduced="no">
  <a class="skip-link" href="#artists">Ir para os artistas</a>
  <div class="visual-field" aria-hidden="true">
    <div id="logo-plate" class="logo-plate">
      <img src="/media/hazewave-world.jpg" alt="" width="1024" height="1536" decoding="async" />
    </div>
    <canvas id="cosmos" aria-hidden="true"></canvas>
    <div class="cinema-vignette"></div>
  </div>
  <header class="site-header">
    <a href="#origin" class="site-name" aria-label="Hazewave, voltar ao início">HAZE<span>WAVE</span><span class="signal-mark" aria-hidden="true">∿</span></a>
    <span class="header-note">UM UNIVERSO EM FREQUÊNCIA</span>
    <a href="#artists" class="header-link">ARTISTAS <span aria-hidden="true">↗</span></a>
  </header>
  <main>
    <div class="narrative-layer" aria-hidden="true">
      <span class="narrative-index">HAZE / WAVE — 001</span>
      <p id="line">Antes da matéria, havia silêncio.</p>
      <span class="narrative-endnote">UM FILME PARA PERCORRER</span>
    </div>
    <section id="origin" class="chapter chapter-origin" aria-label="O nascimento da interferência">
      <div class="chapter-copy">
        <span class="chapter-number">01 / O VAZIO</span>
        <h1>O som<br />muda o <em>universo.</em></h1>
        <p>Existe uma frequência antes de existir um caminho.</p>
      </div>
      <a id="invitation" class="scroll-invitation" href="#crossing">Role para atravessar <span aria-hidden="true">↓</span></a>
    </section>
    <section id="crossing" class="chapter chapter-crossing" aria-label="A travessia da onda">
      <div class="chapter-copy chapter-copy-right">
        <span class="chapter-number">02 / A TRAVESSIA</span>
        <h2>Uma onda.<br /><em>Infinitos mundos.</em></h2>
        <p>A interferência atravessa a névoa. A matéria responde.</p>
      </div>
    </section>
    <section id="revelation" class="chapter chapter-revelation" aria-label="A revelação Hazewave">
      <div class="chapter-copy chapter-copy-center">
        <span class="chapter-number">03 / A REVELAÇÃO</span>
        <h2>Da névoa<br /><em>nasce o sinal.</em></h2>
        <p>O universo se transforma. A identidade permanece.</p>
      </div>
    </section>
    <section id="artists" class="chapter chapter-artists" aria-labelledby="artists-heading">
      <div id="network" class="artist-network">
        <div class="artist-intro">
          <span class="chapter-number">04 / MUNDOS CONECTADOS</span>
          <h2 id="artists-heading">A frequência<br /><em>tem muitos nomes.</em></h2>
          <p>Artistas reais, universos próprios, imagens originais preservadas.</p>
        </div>
        <div class="artist-grid">
          {PUBLIC_ARTISTS.map((artist, index) => (
            <article class="artist-card" id={artist.slug}>
              <a class="artist-card-link" href={"/artists/" + artist.slug + "/"} aria-label={"Entrar no universo de " + artist.name}>
                <img src={artist.image} alt={"Arte original de " + artist.name} loading="lazy" decoding="async" />
                <div class="artist-caption">
                  <span class="artist-index">{String(index + 1).padStart(2, "0")}</span>
                  <h3>{artist.name}</h3>
                </div>
              </a>
            </article>
          ))}
        </div>
        <p class="audio-disclosure">O áudio opcional é uma síntese experimental de interferência — não uma música de artista. Nenhum lançamento foi inventado.</p>
        <a class="return-link" href="#origin">Retornar ao vazio <span aria-hidden="true">↑</span></a>
      </div>
    </section>
  </main>
  <div class="experience-controls">
    <button id="listen" type="button" aria-pressed="false" aria-label="Ativar demonstração sonora sintetizada da interferência">Ouvir a onda</button>
    <span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="sound-legend">SINAL SINTÉTICO · SEM MÚSICA PUBLICADA</span>
  </div>
  <nav class="chapter-rail" aria-label="Navegação entre capítulos">
    <a href="#origin" aria-label="Capítulo um, o vazio">01</a>
    <a href="#crossing" aria-label="Capítulo dois, travessia">02</a>
    <a href="#revelation" aria-label="Capítulo três, revelação">03</a>
    <a href="#artists" aria-label="Capítulo quatro, artistas">04</a>
  </nav>
  <noscript>
    <style>
      .chapter { min-height: auto !important; padding-top: 8rem !important; padding-bottom: 8rem !important; }
      .narrative-layer, .experience-controls, .chapter-rail, .scroll-invitation { display: none !important; }
      #network { display: block !important; }
      .logo-plate { display: grid !important; opacity: .28 !important; }
    </style>
    <p class="noscript-message">A travessia interativa exige JavaScript. Os artistas e suas artes originais continuam acessíveis nesta página.</p>
  </noscript>
  <script>
    import { bootCosmos } from "../experience/boot";
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bootCosmos, { once: true });
    } else {
      bootCosmos();
    }
  </script>
</body>
</html>
