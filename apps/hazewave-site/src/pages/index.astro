<script is:inline>
(()=>{
 "use strict";
 const section=document.querySelector('#journey'),stage=document.querySelector('#stage');
 const pads=[...document.querySelectorAll('#pads .pad')],entry=document.getElementById('artist-entry');
 const clamp=(v)=>Math.max(0,Math.min(1,v));
 const smooth=(a,b,p)=>{const v=clamp((p-a)/(b-a));return v*v*(3-2*v)};
 const bell=(a,b,c,d,p)=>smooth(a,b,p)*(1-smooth(c,d,p));
 const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
 let pending=false,progress=0;
 const set=(name,value)=>stage.style.setProperty('--'+name,String(value));
 function render(){
  pending=false;
  const top=section.getBoundingClientRect().top + window.scrollY;
  const extent=Math.max(1,section.offsetHeight-window.innerHeight);
  const p=clamp((window.scrollY-top)/extent); progress=p;
  const wave=smooth(.08,.37,p),ignite=smooth(.23,.58,p),arrival=smooth(.70,.94,p);
  set('drift',(p*-74).toFixed(2));set('lift',(p*-34).toFixed(2));set('breath',(1+p*.12).toFixed(3));
  set('mist-x',(p*-54).toFixed(2)+'px');set('mist-right',(p*64).toFixed(2)+'px');set('nebula-opacity',(.13+bell(.24,.48,.64,.85,p)*.18).toFixed(3));
