<script is:inline>
(()=>{
 "use strict";
 const section=document.querySelector('#journey'),stage=document.querySelector('#stage');
 const entry=document.getElementById('artist-entry');
 const clamp=(v)=>Math.max(0,Math.min(1,v));
 const smooth=(a,b,p)=>{const v=clamp((p-a)/(b-a));return v*v*(3-2*v)};
 const bell=(a,b,c,d,p)=>smooth(a,b,p)*(1-smooth(c,d,p));
 const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
 let pending=false,progress=0;
 const set=(name,value)=>stage.style.setProperty('--'+name,String(value));
 function render(){
  pending=false;
  const top=section.getBoundingClientRect().top + window.scrollY;
  const extent=Math.max(1,section.offsetHeight-window.innerHeight);
  const p=clamp((window.scrollY-top)/extent); progress=p;
  const wave=smooth(.08,.37,p),ignite=smooth(.23,.58,p),arrival=smooth(.70,.94,p);
  set('drift',(p*-74).toFixed(2));set('lift',(p*-34).toFixed(2));set('breath',(1+p*.12).toFixed(3));
  set('mist-x',(p*-92).toFixed(2)+'px');set('mist-right',(p*135).toFixed(2)+'px');set('nebula-opacity',(.26+bell(.18,.40,.67,.91,p)*.42).toFixed(3));
   const crossing=smooth(.09,.64,p),rupture=bell(.47,.64,.77,.94,p),gateway=bell(.59,.74,.84,.985,p);
   set('camera-x',(-130*crossing+44*arrival).toFixed(2));set('camera-y',(-70*crossing+24*arrival).toFixed(2));
   set('camera-z',(280*crossing+160*rupture).toFixed(2));set('camera-roll',(-11*crossing+9*arrival).toFixed(3));
   set('mid-x',(-160*crossing).toFixed(2));set('mid-y',(95*crossing).toFixed(2));
   set('near-x',(-270*crossing).toFixed(2));set('near-y',(170*crossing).toFixed(2));
   set('star-x',(-86*crossing).toFixed(2));set('star-y',(55*crossing).toFixed(2));
   set('depth-mid',(.5+rupture*.36).toFixed(3));set('depth-near',(.47+rupture*.40).toFixed(3));
   set('star-intensity',(.55+crossing*.28).toFixed(3));set('universe-opacity',(1-smooth(.79,.97,p)*.68).toFixed(3));
   set('interference-opacity',bell(.11,.30,.69,.85,p).toFixed(3));
   set('veil-x',(-210+crossing*290).toFixed(2));set('veil-y',(65-crossing*110).toFixed(2));set('veil-scale',(.64+crossing*.74).toFixed(3));
   set('portal-opacity',gateway.toFixed(3));set('portal-scale',(.16+gateway*1.48+arrival*.48).toFixed(3));
   set('portal-rotate',(-22+crossing*75).toFixed(2));
  set('logo-opacity','1');set('logo-scale',(1-.07*smooth(.12,.73,p)).toFixed(3));
  set('wave-opacity',Math.max(.08,.12+wave*.84-arrival*.91).toFixed(3));set('draw',(1-smooth(.05,.42,p)).toFixed(4));set('wave-shift',(-12+p*16).toFixed(2)+'%');set('wave-y',(Math.sin(p*3.5)*24).toFixed(2)+'px');set('wave-scale',(1+wave*.19).toFixed(3));
  set('sonic-opacity',bell(.19,.39,.68,.84,p).toFixed(3));
  set('sonic-scale',(.57+.52*ignite+.19*rupture).toFixed(3));
  set('sonic-x',(-105+209*crossing).toFixed(1)+'px');
  set('sonic-y',(63-117*crossing).toFixed(1)+'px');
  set('sonic-roll',(-15+crossing*23).toFixed(2));
  set('sonic-travel',(242*crossing).toFixed(1));
  set('sonic-fog',(.24+.65*ignite).toFixed(3));
  set('sonic-ripple',(.30+.65*ignite).toFixed(3));
  set('sonic-draw',(1-smooth(.18,.65,p)).toFixed(4));
  set('slit-opacity',bell(.43,.63,.72,.89,p).toFixed(3));set('slit-shift',(-250+p*340).toFixed(2)+'px');set('slit-scale',(.1+p*2.5).toFixed(3));
  set('approach-opacity',bell(.61,.76,.84,1,p).toFixed(3));
  set('artist-opacity',arrival.toFixed(3));set('artist-y',(25-25*arrival).toFixed(2)+'px');set('artist-scale',(.86+.14*arrival).toFixed(3));
  set('copy-origin',(1-smooth(.18,.31,p)).toFixed(3));set('copy-origin-y',(-25*p).toFixed(1)+'px');
  set('copy-resonance',bell(.28,.43,.51,.64,p).toFixed(3));set('copy-resonance-y',((.5-p)*28).toFixed(1)+'px');
  set('copy-reveal',smooth(.77,.93,p).toFixed(3));set('copy-reveal-y',((1-arrival)*15).toFixed(1)+'px');
  set('hint-opacity',(1-smooth(.06,.16,p)).toFixed(3));
