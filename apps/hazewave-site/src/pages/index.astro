  set('entry-y',((1-entryOpacity)*14).toFixed(1)+'px');set('entry-events',entryOpacity>.95?'auto':'none');
  entry.tabIndex=entryOpacity>.95?0:-1;
  
  document.body.dataset.storyProgress=p.toFixed(3);
  document.body.dataset.storyState=p<.22?'silence':p<.44?'interference':p<.73?'resonance':p<.93?'handoff':'artist';
 }
 function onScroll(){if(!pending){pending=true;requestAnimationFrame(render)}}
 addEventListener('scroll',onScroll,{passive:true});addEventListener('resize',onScroll,{passive:true});
