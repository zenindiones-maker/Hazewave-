---
import "../styles/global.css";
import { artists, tracks } from "../data/catalog";
import { artistChapters } from "../data/artistChapters";
import { merchItems, siteIdentity, socials } from "../data/site";

const artistById = new Map(artists.map((artist) => [artist.id, artist]));
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050706" />
    <meta name="description" content="Hazewave — experiência musical interativa criada por HAZE + WAVE." />
    <title>Hazewave — Resonance World</title>
  </head>
  <body>
    <div
      class="site-backdrop"
      aria-hidden="true"
      style={`--world-art:url("${siteIdentity.backgroundAsset}")`}
    >
      <img
        class="site-backdrop-source"
        src={siteIdentity.backgroundAsset}
        alt=""
        decoding="async"
        fetchpriority="high"
      />
      <span class="site-backdrop-water-image"></span>
      <span class="site-backdrop-water"></span>
      <span class="site-backdrop-fog"></span>
      <span class="site-backdrop-light"></span>
      <div class="world-artist-echoes" aria-hidden="true">
        {artistChapters.map((chapter, index) => (
          <span
            class="world-artist-echo"
            data-world-artist-id={chapter.id}
            style={`--echo-accent:${chapter.world.accent};--echo-index:${index};`}
          >
            <small>0{index + 1} / DEMO WORLD</small>
            <strong>{chapter.displayName}</strong>
            <i>{chapter.world.transitionSignature}</i>
          </span>
        ))}
      </div>
      <span class="site-backdrop-scrim"></span>
    </div>

    <nav class="world-focus-controls" aria-label="Entrar nos mundos de artistas demonstrativos">
      {artistChapters.map((chapter, index) => (
        <button
          type="button"
          data-world-focus-control={chapter.id}
          aria-controls={`artist-focus-${chapter.id}`}
          aria-label={`Entrar no mundo demonstrativo de ${chapter.displayName}`}
          aria-pressed="false"
          style={`--world-focus-accent:${chapter.world.accent};--world-focus-index:${index};`}
        >
          <span>0{index + 1}</span>
          <strong>{chapter.displayName}</strong>
          <i aria-hidden="true">ENTER ↗</i>
        </button>
      ))}
    </nav>

    <nav class="story-rail" aria-label="Capítulos do arquivo Hazewave">
      <span class="story-progress" aria-hidden="true"><i></i></span>
      <a href="#threshold" data-story-link="threshold"><b>00</b><span>THRESHOLD</span></a>
      <a href="#archive" data-story-link="archive"><b>01</b><span>ARCHIVE</span></a>
      <a href="#artist-worlds" data-story-link="artists"><b>02</b><span>ARTIST WORLDS</span></a>
      <a href="#dossiers" data-story-link="dossiers"><b>03</b><span>DOSSIERS</span></a>
      <a href="#objects" data-story-link="merch"><b>04</b><span>OBJECTS</span></a>
      <a href="#network" data-story-link="network"><b>05</b><span>NETWORK</span></a>
    </nav>

    <div id="site-loader" class="site-loader" data-state="loading" aria-hidden="true">
      <span class="loader-noise"></span>
      <span class="loader-reel loader-reel-a"></span>
      <span class="loader-reel loader-reel-b"></span>
      <strong>HAZEWAVE</strong>
      <small>LOADING ARCHIVE / TAPE SIGNAL</small>
    </div>

    <main class="shell">
      <header class="masthead">
        <a class="brand" href="/" aria-label="Hazewave início">
          <span>HAZE</span><i></i><span>WAVE</span>
        </a>
        <div class="masthead-meta" aria-hidden="true">
          <span>INTERACTIVE MUSIC OBJECTS</span>
          <span class="masthead-dot"></span>
          <span>2026</span>
        </div>
      </header>

      <section id="threshold" class="archive-hero" aria-labelledby="archive-hero-title">
        <div class="archive-hero-copy">
          <p class="eyebrow">SANTOS / 2021— / INDEPENDENT SOUND</p>
          <h1 id="archive-hero-title" class="sr-only">Hazewave</h1>
          <p class="archive-tagline">{siteIdentity.tagline}</p>
          <button id="enter-archive" class="archive-enter" type="button" data-scroll-target="#archive">
            <span>{siteIdentity.archiveCta}</span>
            <i aria-hidden="true">↘</i>
          </button>
        </div>
        <div class="archive-hero-index" aria-hidden="true">
          <span>01</span>
          <span>ARCHIVE WORLD</span>
        </div>
      </section>

      <section id="archive" class="experience" aria-labelledby="experience-title">
        <div class="scene-frame">
          <div id="premium-stage" class="premium-stage" data-playing="false" data-phase="idle">
            <div class="world-glow" aria-hidden="true"></div>
            <div class="world-lines" aria-hidden="true"></div>
            <div class="world-grain" aria-hidden="true"></div>

            <div class="artist-worlds" aria-hidden="true">
              <div class="artist-world artist-world-aether" data-world="aether">
                <svg viewBox="0 0 900 900" focusable="false">
                  <defs>
                    <linearGradient id="aether-stroke" x1="0" x2="1">
                      <stop offset="0" stop-color="#a7ffe0" stop-opacity="0" />
                      <stop offset=".5" stop-color="#a7ffe0" stop-opacity=".75" />
                      <stop offset="1" stop-color="#a7ffe0" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <circle class="world-ring ring-a" cx="450" cy="450" r="260" />
                  <circle class="world-ring ring-b" cx="450" cy="450" r="330" />
                  <path class="world-curve curve-a" d="M60 560 C210 260 620 180 840 420" />
                  <path class="world-curve curve-b" d="M80 650 C300 410 600 430 820 610" />
                  <path class="world-scan" d="M120 455 H780" stroke="url(#aether-stroke)" />
                </svg>
              </div>

              <div class="artist-world artist-world-monolith" data-world="monolith">
                <span class="slab slab-a"></span>
                <span class="slab slab-b"></span>
                <span class="slab slab-c"></span>
                <span class="slab slab-d"></span>
                <span class="fault fault-a"></span>
                <span class="fault fault-b"></span>
              </div>

              <div class="artist-world artist-world-flora" data-world="flora">
                <svg viewBox="0 0 900 900" focusable="false">
                  <path class="flora-stem stem-a" d="M90 820 C250 620 250 360 430 120" />
                  <path class="flora-stem stem-b" d="M810 800 C650 620 660 390 490 100" />
                  <path class="flora-leaf leaf-a" d="M270 550 C160 520 130 430 155 355 C255 370 315 445 270 550 Z" />
                  <path class="flora-leaf leaf-b" d="M625 460 C650 345 735 305 810 330 C785 430 715 485 625 460 Z" />
                  <path class="flora-leaf leaf-c" d="M455 635 C545 595 635 630 690 710 C585 755 495 720 455 635 Z" />
                  <circle class="flora-spore spore-a" cx="430" cy="120" r="12" />
                  <circle class="flora-spore spore-b" cx="490" cy="100" r="9" />
                  <circle class="flora-spore spore-c" cx="560" cy="255" r="7" />
                </svg>
              </div>
            </div>

            <div class="world-signature" aria-hidden="true">
              <span id="world-artist-name">HAZEWAVE</span>
            </div>

            <div class="world-meta" aria-hidden="true">
              <span id="world-release">RESONANCE ARCHIVE</span>
              <strong id="world-track">SELECT A SIGNAL</strong>
            </div>

            <div class="scene-copy">
              <p class="eyebrow">ACERVO / FITAS DE ARTISTA</p>
              <h2 id="experience-title">Escolha a fita.</h2>
              <p class="intro">Um toque leva o som da estante até a mesa.</p>
            </div>

            <div class="deck-stage">
              <div id="resonance-deck" class="resonance-deck" data-state="idle">
                <div class="deck-shadow"></div>
                <div class="deck-outer-halo"></div>
                <div class="deck-arch">
                  <div class="deck-arch-line"></div>
                </div>

                <div class="deck-core">
                  <div class="deck-orbit deck-orbit-a" aria-hidden="true"></div>
                  <div class="deck-orbit deck-orbit-b" aria-hidden="true"></div>
                  <div class="deck-contact-flash" aria-hidden="true"></div>

                  <div id="player-wheel" class="deck-wheel" role="group" aria-label="Controle circular do player Hazewave">
                    <div
                      id="wheel-ring-control"
                      class="wheel-ring-control"
                      role="slider"
                      tabindex="0"
                      aria-label="Volume do player"
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-valuenow="82"
                      aria-valuetext="Volume 82%"
                    >
                      <span class="wheel-center" aria-hidden="true">
                        <strong id="wheel-volume">82</strong>
                        <small>VOL</small>
                      </span>
                    </div>
                    <button type="button" class="wheel-key wheel-menu" data-wheel-action="archive" aria-label="Voltar ao acervo">LIST</button>
                    <button type="button" class="wheel-key wheel-prev" data-wheel-action="previous" aria-label="Faixa anterior">‹‹</button>
                    <button type="button" class="wheel-key wheel-next" data-wheel-action="next" aria-label="Próxima faixa">››</button>
                    <button type="button" class="wheel-key wheel-play" data-wheel-action="toggle" aria-label="Tocar ou pausar">▶Ⅱ</button>
                  </div>

                  <div class="deck-gate deck-gate-left" aria-hidden="true"></div>
                  <div class="deck-gate deck-gate-right" aria-hidden="true"></div>
                  <div id="deck-slot" class="deck-slot">
                    <span class="slot-line" aria-hidden="true"></span>
                    <span class="slot-contact-rail" aria-hidden="true">
                      <i></i><i></i><i></i><i></i><i></i>
                    </span>
                    <span class="slot-label">TAPE PORT</span>
                  </div>
                </div>

                <div class="deck-neck"></div>

                <div class="deck-console">
                  <div id="deck-screen" class="deck-screen" data-view="now">
                    <div class="deck-screen-now">
                      <span class="screen-kicker">HAZEWAVE / ACTIVE OBJECT</span>
                      <strong id="deck-screen-title">Awaiting signal</strong>
                      <span id="deck-screen-artist">Select a resonance object</span>
                      <div class="screen-meter" aria-hidden="true">
                        <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
                      </div>
                    </div>
                    <div class="deck-screen-list" aria-label="Faixas da fita selecionada">
                      <span class="screen-kicker">TAPE / TRACKLIST</span>
                      <ol id="deck-tracklist"></ol>
                    </div>
                  </div>
                  <div class="deck-control" aria-hidden="true">
                    <span></span>
                  </div>
                </div>
              </div>
            </div>

            <aside class="deck-beacon" data-active="false" aria-hidden="true">
              <span class="deck-beacon-index">ACTIVE SIGNAL</span>
              <strong id="deck-beacon-track">SELECT OBJECT</strong>
              <span id="deck-beacon-artist">HAZEWAVE</span>
              <span id="deck-beacon-section">IDLE</span>
            </aside>

            <nav class="artifact-field" aria-label="Fitas de artista demonstrativas">
              {artists.map((artist, index) => {
                const primaryTrack = artist.tracks[0]!;
                return (
                  <button
                    class="resonance-artifact"
                    type="button"
                    data-track-id={primaryTrack.id}
                    data-artist={artist.id}
                    data-artist-cassette="true"
                    data-focus="idle"
                    data-loaded="false"
                    aria-label={`Abrir fita de ${artist.name.replace(" / DEMO", "")}`}
                    style={`--accent:${artist.identity.accent};--secondary:${artist.identity.secondary};--world:${artist.identity.background};--artifact-index:${index};`}
                  >
                    <span class="artifact-shell" aria-hidden="true">
                      <span class="artifact-glass"></span>
                      {artist.id === "aether" && (
                        <svg class="artifact-artwork artwork-aether" viewBox="0 0 100 100" focusable="false">
                          <circle cx="52" cy="48" r="26" />
                          <circle cx="52" cy="48" r="18" />
                          <circle cx="52" cy="48" r="8" />
                          <path d="M13 63 C28 31 69 18 91 43" />
                          <path d="M19 74 C38 50 66 43 87 58" />
                        </svg>
                      )}
                      {artist.id === "monolith" && (
                        <svg class="artifact-artwork artwork-monolith" viewBox="0 0 100 100" focusable="false">
                          <rect x="18" y="20" width="64" height="60" rx="4" />
                          <rect x="26" y="28" width="48" height="44" rx="2" />
                          <path d="M18 50 H82 M50 20 V80" />
                          <path d="M31 37 L69 63 M69 37 L31 63" />
                        </svg>
                      )}
                      {artist.id === "flora" && (
                        <svg class="artifact-artwork artwork-flora" viewBox="0 0 100 100" focusable="false">
                          <path d="M50 84 C47 62 49 43 61 18" />
                          <path d="M50 61 C35 59 26 49 22 36 C39 35 50 44 50 61 Z" />
                          <path d="M54 48 C56 34 67 27 80 27 C77 41 68 49 54 48 Z" />
                          <path d="M49 72 C61 68 72 72 79 82 C64 86 54 82 49 72 Z" />
                          <circle cx="61" cy="18" r="4" />
                        </svg>
                      )}
                      <span class="artifact-signal">
                        <i></i><i></i><i></i>
                      </span>
                      <span class="cassette-reels">
                        <i></i><i></i>
                      </span>
                      <span class="cassette-window"></span>
                      <span class="artifact-number">0{index + 1}</span>
                      <span class="artifact-face-copy">
                        <strong>{artist.name.replace(" / DEMO", "")}</strong>
                        <small>{artist.releaseTitle}</small>
                      </span>
                      <span class="artifact-contacts">
                        <i></i><i></i><i></i><i></i><i></i>
                      </span>
                      <span class="artifact-mark"></span>
                    </span>
                    <span class="artifact-copy">
                      <small>ARTIST TAPE</small>
                      <strong>{artist.name.replace(" / DEMO", "")}</strong>
                      <span>{artist.tracks.length} TRACKS</span>
                    </span>
                  </button>
                );
              })}
            </nav>

            <div class="runtime-badge" id="runtime-badge" role="status">
              <span class="pulse"></span>
              <span id="runtime-label">INITIALIZING</span>
            </div>
          </div>
        </div>
      </section>

      <section class="player" data-active="false" aria-label="Player Hazewave">
        <div class="player-copy">
          <p class="player-kicker">NOW RESONATING</p>
          <strong id="player-title">Escolha um objeto</strong>
          <span id="player-artist">SELECT A RESONANCE OBJECT</span>
        </div>

        <div class="player-timeline">
          <div id="player-sections" class="player-sections" aria-hidden="true"></div>
          <input
            id="player-seek"
            type="range"
            min="0"
            max="24"
            step="0.05"
            value="0"
            disabled
            aria-label="Posição da música"
          />
          <div class="player-time" aria-hidden="true">
            <span id="player-time-current">0:00</span>
            <span id="player-section-label">SIGNAL MAP</span>
            <span id="player-time-total">0:24</span>
          </div>
        </div>

        <div class="player-state">
          <span id="state-label" aria-live="polite">IDLE</span>
          <button id="toggle-play" type="button" disabled aria-label="Pausar ou continuar música">PAUSE</button>
        </div>
      </section>

      <section id="artist-worlds" class="artist-index artist-journey" aria-labelledby="artist-index-title">
        <header class="artist-journey-intro">
          <p class="eyebrow">HAZEWAVE / ARTIST WORLDS / DEMO STRUCTURE</p>
          <h2 id="artist-index-title">O mundo muda antes do artista aparecer.</h2>
          <p>
            A rolagem atravessa o mesmo universo. Cada capítulo altera luz,
            água, névoa e matéria sem abandonar a imagem original.
          </p>
        </header>

        <div class="artist-journey-track">
          {artistChapters.map((chapter, artistIndex) => (
            <article
              class="artist-chapter"
              data-artist-chapter={chapter.id}
              data-authority={chapter.authority}
              style={`--chapter-accent:${chapter.world.accent};--chapter-secondary:${chapter.world.secondary};--chapter-bg:${chapter.world.background};--chapter-index:${artistIndex};`}
            >
              <button
                class="artist-chapter-mark"
                type="button"
                data-artist-focus={chapter.id}
                aria-expanded="false"
                aria-controls={`artist-focus-${chapter.id}`}
                aria-label={`Entrar no mundo de ${chapter.displayName}`}
              >
                <span>0{artistIndex + 1}</span>
                <i aria-hidden="true"></i>
                <small>{chapter.world.transitionSignature}</small>
              </button>

              <div class="artist-chapter-copy">
                <span class="artist-chapter-kicker">DEMO ARTIST WORLD</span>
                <h3>{chapter.displayName}</h3>
                <p>{chapter.releaseLabel} · DEMO CONTENT</p>

                <nav class="artist-chapter-tracks" aria-label={`Faixas demonstrativas de ${chapter.displayName}`}>
                  {chapter.tracks.map((track, trackIndex) => (
                    <button
                      type="button"
                      data-archive-track-id={track.id}
                      aria-label={`Tocar ${track.title} no Resonance Deck`}
                    >
                      <b>0{trackIndex + 1}</b>
                      <span>{track.title}</span>
                      <small>{track.visual.bpm} BPM</small>
                    </button>
                  ))}
                </nav>
              </div>

              <div class="artist-chapter-status" aria-hidden="true">
                <span>WORLD SIGNAL</span>
                <strong>{chapter.authority}</strong>
                <i></i>
              </div>

              <div
                id={`artist-focus-${chapter.id}`}
                class="artist-focus-portal"
                data-artist-focus-panel={chapter.id}
                data-open="false"
              >
                <div class="artist-focus-meta">
                  <span>IN-WORLD FOCUS</span>
                  <strong>{chapter.displayName}</strong>
                </div>

                <div class="artist-focus-video" data-video-portal={chapter.id} data-authorized={String(Boolean(chapter.videoSource))}>
                  {chapter.videoSource ? (
                    <button
                      type="button"
                      data-video-source={chapter.videoSource}
                      data-video-artist={chapter.id}
                      aria-label={`Abrir clipe autorizado de ${chapter.displayName}`}
                    >
                      OPEN VISUAL
                    </button>
                  ) : (
                    <button
                      type="button"
                      disabled
                      aria-label={`Clipe de ${chapter.displayName} ainda não autorizado`}
                    >
                      VIDEO AUTHORITY UNSET
                    </button>
                  )}
                  <div class="artist-video-mount" data-video-mount={chapter.id}></div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="dossiers" class="dossier-zone dossier-transition" aria-labelledby="dossier-title">
        <header class="section-heading dossier-transition-heading">
          <p class="eyebrow">FOCUS / OWNER MEDIA GATE</p>
          <h2 id="dossier-title">O arquivo só revela o que é verdadeiro.</h2>
          <p>
            Foto, biografia e clipe entram neste mundo somente quando o owner
            autorizar a fonte final. A experiência permanece pronta sem inventar conteúdo.
          </p>
        </header>

        <div class="dossier-signal-list" aria-label="Estado dos dossiers demonstrativos">
          {artistChapters.map((chapter, index) => (
            <article
              class="dossier-signal"
              data-dossier-artist={chapter.id}
              style={`--dossier-accent:${chapter.world.accent};--dossier-index:${index};`}
            >
              <span class="dossier-signal-index">0{index + 1}</span>
              <div class="dossier-signal-name">
                <small>DEMO WORLD</small>
                <h3>{chapter.displayName}</h3>
                <p>{chapter.releaseLabel}</p>
              </div>
              <dl>
                <div><dt>PHOTO</dt><dd>{chapter.portraitAsset ? "READY" : "UNSET"}</dd></div>
                <div><dt>BIO</dt><dd>{chapter.biography ? "READY" : "UNSET"}</dd></div>
                <div><dt>VIDEO</dt><dd>{chapter.videoSource ? "READY" : "UNSET"}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </section>

      <section id="objects" class="merch-zone" aria-labelledby="merch-title">
        <header class="section-heading merch-heading">
          <p class="eyebrow">BANCA / OBJECTS</p>
          <h2 id="merch-title">Merch como objeto, não como catálogo genérico.</h2>
        </header>

        <div class="merch-stand">
          {merchItems.map((item, index) => (
            <article class="merch-object" data-merch-id={item.id} style={`--merch-accent:${item.accent};--merch-index:${index};`}>
              <div class:list={["merch-model", `merch-model-${item.category.toLowerCase()}`]} aria-hidden="true">
                <span class="merch-model-core"></span>
                <span class="merch-model-mark">HZ</span>
              </div>
              <div class="merch-copy">
                <span>{item.category} / {item.status}</span>
                <h3>{item.name}</h3>
                <button
                  type="button"
                  class="merch-contact"
                  disabled
                  aria-label={`${item.name}: contato de compra ainda não autorizado`}
                >
                  CONTACT DESTINATION UNSET
                </button>
              </div>
            </article>
          ))}
        </div>
        <p class="merch-note">Conceito visual somente. Preço, disponibilidade e destino de compra permanecem bloqueados até autorização explícita do owner.</p>
      </section>

      <footer id="network" class="social-footer">
        <div class="social-footer-title">
          <span>HAZEWAVE / NETWORK</span>
          <strong>Santos ↗ mundo</strong>
        </div>
        <nav aria-label="Redes sociais">
          {socials.map((social) => (
            <a href={social.href} target="_blank" rel="noreferrer" aria-label={social.label}>{social.handle}</a>
          ))}
        </nav>
        <span class="social-footer-meta">NO ICONS / DIRECT SIGNAL</span>
      </footer>

      <noscript>
        <p class="fallback-note">JavaScript está desativado. O catálogo continua acessível, mas a experiência interativa precisa de JavaScript.</p>
      </noscript>
    </main>

    <script>
      import { bootHazewaveSite } from "../experience/boot";
      bootHazewaveSite();
    </script>
  </body>
</html>
