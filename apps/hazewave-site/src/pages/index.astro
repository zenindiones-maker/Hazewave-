---
import "../styles/global.css";
import { artists } from "../data/catalog";
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070909" />
    <meta name="description" content="Hazewave — experiência musical interativa criada por HAZE + WAVE." />
    <title>Hazewave — Resonance World</title>
  </head>
  <body>
    <main class="shell">
      <header class="masthead">
        <a class="brand" href="/" aria-label="Hazewave início">
          <span>HAZE</span><i></i><span>WAVE</span>
        </a>
        <div class="masthead-meta">
          <span>INTERACTIVE MUSIC WORLD</span>
          <span class="masthead-dot"></span>
          <span>WAVE / 2026</span>
        </div>
      </header>

      <section class="experience" aria-labelledby="experience-title">
        <div class="scene-frame">
          <canvas id="resonance-canvas" aria-hidden="true"></canvas>
          <div class="scene-vignette"></div>

          <div class="scene-copy">
            <p class="eyebrow">HAZEWAVE / RESONANCE WORLD</p>
            <h1 id="experience-title">Escolha um artefato.<br />Ative o mundo.</h1>
            <p class="intro">Cada faixa vive em um objeto físico digital. Um toque inicia a coreografia, conecta o Deck e transforma a cena.</p>
          </div>

          <div class="interaction-hint" aria-hidden="true">
            <span class="hint-pulse"></span>
            <span>TOQUE EM UM ARTEFATO</span>
          </div>

          <nav class="media-dock" aria-label="Faixas demonstrativas">
            {artists.map((artist) => (
              <section class="artist-cluster" data-artist={artist.id}>
                <div class="artist-cluster-label">
                  <span>{artist.name.replace(" / DEMO", "")}</span>
                  <small>{artist.releaseTitle}</small>
                </div>
                <div class="media-row">
                  {artist.tracks.map((track, index) => (
                    <button
                      class="track"
                      type="button"
                      data-track-id={track.id}
                      aria-label={`Tocar ${track.title}, ${artist.name}`}
                      style={`--accent:${artist.identity.accent}; --index:${index};`}
                    >
                      <span class="track-art" aria-hidden="true">
                        <span class="track-code">0{index + 1}</span>
                        <span class="track-glyph"></span>
                      </span>
                      <span class="track-meta">
                        <strong>{track.title}</strong>
                        <small>{track.visual.bpm} BPM</small>
                      </span>
                    </button>
                  ))}
                </div>
              </section>
            ))}
          </nav>

          <div class="runtime-badge" id="runtime-badge" role="status">
            <span class="pulse"></span>
            <span id="runtime-label">INITIALIZING</span>
          </div>
        </div>
      </section>

      <section class="player" aria-label="Player Hazewave">
        <div class="player-copy">
          <p class="player-kicker">NOW RESONATING</p>
          <strong id="player-title">Escolha um artefato</strong>
          <span id="player-artist">DEMO AUDIO / RIGHTS SAFE</span>
        </div>
        <div class="player-state">
          <span id="state-label" aria-live="polite">IDLE</span>
          <button id="toggle-play" type="button" disabled aria-label="Pausar ou continuar música">PAUSE</button>
        </div>
      </section>

      <noscript>
        <p class="fallback-note">JavaScript está desativado. O conteúdo continua acessível, mas a experiência visual e o player interativo precisam de JavaScript.</p>
      </noscript>
    </main>

    <script>
      import { bootHazewaveSite } from "../experience/boot";
      bootHazewaveSite();
    </script>
  </body>
</html>
