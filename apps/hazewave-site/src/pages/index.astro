 if(reduced)document.documentElement.dataset.reducedMotion='true';
 render();window.__HAZEWAVE_STORY={get progress(){return progress},get artistCount(){return 1},get stage(){return document.body.dataset.storyState},version:'cosmic-interference-v12'};
