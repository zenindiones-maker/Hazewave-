---
import "../styles/global.css";
import { artists, tracks } from "../data/catalog";

const artistById = new Map(artists.map((artist) => [artist.id, artist]));
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050706" />
    <meta name="description" content="Hazewave — experiência musical interativa criada por HAZE + WAVE." />
    <title>Hazewave — Resonance World</title>
  </head>
  <body>
    <main class="shell">
      <header class="masthead">
        <a class="brand" href="/" aria-label="Hazewave início">
          <span>HAZE</span><i></i><span>WAVE</span>
        </a>
        <div class="masthead-meta" aria-hidden="true">
          <span>INTERACTIVE MUSIC OBJECTS</span>
          <span class="masthead-dot"></span>
          <span>2026</span>
        </div>
      </header>

      <section class="experience" aria-labelledby="experience-title">
        <div class="scene-frame">
          <div id="premium-stage" class="premium-stage" data-playing="false">
            <div class="world-glow" aria-hidden="true"></div>
            <div class="world-lines" aria-hidden="true"></div>
            <div class="world-grain" aria-hidden="true"></div>

            <div class="artist-worlds" aria-hidden="true">
              <div class="artist-world artist-world-aether" data-world="aether">
                <svg viewBox="0 0 900 900" focusable="false">
                  <defs>
                    <linearGradient id="aether-stroke" x1="0" x2="1">
                      <stop offset="0" stop-color="#a7ffe0" stop-opacity="0" />
                      <stop offset=".5" stop-color="#a7ffe0" stop-opacity=".75" />
                      <stop offset="1" stop-color="#a7ffe0" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <circle class="world-ring ring-a" cx="450" cy="450" r="260" />
                  <circle class="world-ring ring-b" cx="450" cy="450" r="330" />
                  <path class="world-curve curve-a" d="M60 560 C210 260 620 180 840 420" />
                  <path class="world-curve curve-b" d="M80 650 C300 410 600 430 820 610" />
                  <path class="world-scan" d="M120 455 H780" stroke="url(#aether-stroke)" />
                </svg>
              </div>

              <div class="artist-world artist-world-monolith" data-world="monolith">
                <span class="slab slab-a"></span>
                <span class="slab slab-b"></span>
                <span class="slab slab-c"></span>
                <span class="slab slab-d"></span>
                <span class="fault fault-a"></span>
                <span class="fault fault-b"></span>
              </div>

              <div class="artist-world artist-world-flora" data-world="flora">
                <svg viewBox="0 0 900 900" focusable="false">
                  <path class="flora-stem stem-a" d="M90 820 C250 620 250 360 430 120" />
                  <path class="flora-stem stem-b" d="M810 800 C650 620 660 390 490 100" />
                  <path class="flora-leaf leaf-a" d="M270 550 C160 520 130 430 155 355 C255 370 315 445 270 550 Z" />
                  <path class="flora-leaf leaf-b" d="M625 460 C650 345 735 305 810 330 C785 430 715 485 625 460 Z" />
                  <path class="flora-leaf leaf-c" d="M455 635 C545 595 635 630 690 710 C585 755 495 720 455 635 Z" />
                  <circle class="flora-spore spore-a" cx="430" cy="120" r="12" />
                  <circle class="flora-spore spore-b" cx="490" cy="100" r="9" />
                  <circle class="flora-spore spore-c" cx="560" cy="255" r="7" />
                </svg>
              </div>
            </div>

            <div class="world-signature" aria-hidden="true">
              <span id="world-artist-name">HAZEWAVE</span>
            </div>

            <div class="world-meta" aria-hidden="true">
              <span id="world-release">RESONANCE ARCHIVE</span>
              <strong id="world-track">SELECT A SIGNAL</strong>
            </div>

            <div class="scene-copy">
              <p class="eyebrow">HAZEWAVE / RESONANCE OBJECTS</p>
              <h1 id="experience-title">Toque. Conecte. Escute.</h1>
              <p class="intro">Cada faixa vive em um objeto próprio. Um toque leva a música até o Deck.</p>
            </div>

            <div class="deck-stage" aria-hidden="true">
              <div id="resonance-deck" class="resonance-deck" data-state="idle">
                <div class="deck-shadow"></div>
                <div class="deck-outer-halo"></div>
                <div class="deck-arch">
                  <div class="deck-arch-line"></div>
                </div>

                <div class="deck-core">
                  <div class="deck-orbit deck-orbit-a"></div>
                  <div class="deck-orbit deck-orbit-b"></div>
                  <div class="deck-contact-flash"></div>
                  <div class="deck-gate deck-gate-left"></div>
                  <div class="deck-gate deck-gate-right"></div>
                  <div id="deck-slot" class="deck-slot">
                    <span class="slot-line"></span>
                    <span class="slot-label">RESONANCE PORT</span>
                  </div>
                </div>

                <div class="deck-neck"></div>

                <div class="deck-console">
                  <div class="deck-screen">
                    <span class="screen-kicker">HAZEWAVE / ACTIVE OBJECT</span>
                    <strong id="deck-screen-title">Awaiting signal</strong>
                    <span id="deck-screen-artist">Select a resonance object</span>
                    <div class="screen-meter" aria-hidden="true">
                      <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
                    </div>
                  </div>
                  <div class="deck-control" aria-hidden="true">
                    <span></span>
                  </div>
                </div>
              </div>
            </div>

            <nav class="artifact-field" aria-label="Faixas demonstrativas">
              {tracks.map((track, index) => {
                const artist = artistById.get(track.artistId)!;
                return (
                  <button
                    class="resonance-artifact"
                    type="button"
                    data-track-id={track.id}
                    data-artist={artist.id}
                    data-focus="idle"
                    data-loaded="false"
                    aria-label={`Tocar ${track.title}, ${artist.name}`}
                    style={`--accent:${artist.identity.accent};--secondary:${artist.identity.secondary};--world:${artist.identity.background};--artifact-index:${index};`}
                  >
                    <span class="artifact-shell" aria-hidden="true">
                      <span class="artifact-glass"></span>
                      {artist.id === "aether" && (
                        <svg class="artifact-artwork artwork-aether" viewBox="0 0 100 100" focusable="false">
                          <circle cx="52" cy="48" r="26" />
                          <circle cx="52" cy="48" r="18" />
                          <circle cx="52" cy="48" r="8" />
                          <path d="M13 63 C28 31 69 18 91 43" />
                          <path d="M19 74 C38 50 66 43 87 58" />
                        </svg>
                      )}
                      {artist.id === "monolith" && (
                        <svg class="artifact-artwork artwork-monolith" viewBox="0 0 100 100" focusable="false">
                          <rect x="18" y="20" width="64" height="60" rx="4" />
                          <rect x="26" y="28" width="48" height="44" rx="2" />
                          <path d="M18 50 H82 M50 20 V80" />
                          <path d="M31 37 L69 63 M69 37 L31 63" />
                        </svg>
                      )}
                      {artist.id === "flora" && (
                        <svg class="artifact-artwork artwork-flora" viewBox="0 0 100 100" focusable="false">
                          <path d="M50 84 C47 62 49 43 61 18" />
                          <path d="M50 61 C35 59 26 49 22 36 C39 35 50 44 50 61 Z" />
                          <path d="M54 48 C56 34 67 27 80 27 C77 41 68 49 54 48 Z" />
                          <path d="M49 72 C61 68 72 72 79 82 C64 86 54 82 49 72 Z" />
                          <circle cx="61" cy="18" r="4" />
                        </svg>
                      )}
                      <span class="artifact-signal">
                        <i></i><i></i><i></i>
                      </span>
                      <span class="artifact-number">0{index + 1}</span>
                      <span class="artifact-mark"></span>
                    </span>
                    <span class="artifact-copy">
                      <small>{artist.name.replace(" / DEMO", "")}</small>
                      <strong>{track.title}</strong>
                      <span>{track.visual.bpm} BPM</span>
                    </span>
                  </button>
                );
              })}
            </nav>

            <div class="runtime-badge" id="runtime-badge" role="status">
              <span class="pulse"></span>
              <span id="runtime-label">INITIALIZING</span>
            </div>
          </div>
        </div>
      </section>

      <section class="player" data-active="false" aria-label="Player Hazewave">
        <div class="player-copy">
          <p class="player-kicker">NOW RESONATING</p>
          <strong id="player-title">Escolha um objeto</strong>
          <span id="player-artist">SELECT A RESONANCE OBJECT</span>
        </div>

        <div class="player-timeline">
          <input
            id="player-seek"
            type="range"
            min="0"
            max="24"
            step="0.05"
            value="0"
            disabled
            aria-label="Posição da música"
          />
          <div class="player-time" aria-hidden="true">
            <span id="player-time-current">0:00</span>
            <span id="player-time-total">0:24</span>
          </div>
        </div>

        <div class="player-state">
          <span id="state-label" aria-live="polite">IDLE</span>
          <button id="toggle-play" type="button" disabled aria-label="Pausar ou continuar música">PAUSE</button>
        </div>
      </section>

      <section class="artist-index" aria-labelledby="artist-index-title">
        <header class="artist-index-header">
          <p class="eyebrow">HAZEWAVE / ARTIST WORLDS</p>
          <h2 id="artist-index-title">Cada artista ocupa um mundo.</h2>
          <p>O mesmo player muda de matéria, ritmo e atmosfera conforme a música.</p>
        </header>

        <div class="artist-index-grid">
          {artists.map((artist, artistIndex) => (
            <article class="artist-index-card" data-artist-card={artist.id} style={`--card-accent:${artist.identity.accent};--card-world:${artist.identity.background};--card-index:${artistIndex};`}>
              <div class="artist-index-art" aria-hidden="true">
                <span class="artist-index-orbit"></span>
                <span class="artist-index-core"></span>
              </div>
              <div class="artist-index-copy">
                <span>0{artistIndex + 1}</span>
                <h3>{artist.name.replace(" / DEMO", "")}</h3>
                <p>{artist.releaseTitle}</p>
                <ul>
                  {artist.tracks.map((track) => <li>{track.title}<small>{track.visual.bpm} BPM</small></li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </section>

      <noscript>
        <p class="fallback-note">JavaScript está desativado. O catálogo continua acessível, mas a experiência interativa precisa de JavaScript.</p>
      </noscript>
    </main>

    <script>
      import { bootHazewaveSite } from "../experience/boot";
      bootHazewaveSite();
    </script>
  </body>
</html>
