{
  "name": "Hazewave Zero-Cost Audio Workstation",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "containerEnv": {
    "HAZEWAVE_ZERO_COST": "1"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Hazewave Desktop",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash scripts/codespaces/bootstrap-zero-cost.sh",
  "postStartCommand": "bash scripts/codespaces/start-desktop.sh",
  "remoteUser": "vscode"
}
