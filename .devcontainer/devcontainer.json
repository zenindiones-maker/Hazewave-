{
  "name": "Hazewave Professional Zero-Cost Workstation",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "containerEnv": {
    "HAZEWAVE_ZERO_COST": "1",
    "HAZEWAVE_REMOTE_TRANSPORT": "XPRA_HTML5"
  },
  "forwardPorts": [14500, 6080],
  "portsAttributes": {
    "14500": {
      "label": "Hazewave Professional Desktop",
      "onAutoForward": "silent",
      "protocol": "http"
    },
    "6080": {
      "label": "Hazewave noVNC Fallback",
      "onAutoForward": "silent",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash scripts/codespaces/bootstrap-zero-cost.sh && bash scripts/codespaces/upgrade-professional-v2.sh",
  "postStartCommand": "bash scripts/codespaces/start-professional-desktop.sh || { echo 'XPRA_START=FAIL_FALLBACK_NOVNC'; bash scripts/codespaces/start-desktop.sh; }",
  "remoteUser": "vscode"
}
