{
  "schema": "HazewaveReflexLatencyPolicy/v1",
  "project_id": "HAZEWAVE",
  "authority": "HAZEWAVE_HARNESS",
  "provider_authority": "NONE",
  "activation_state": "MEASURE_BEFORE_ACTIVATE",
  "target_capability": "decision.route",
  "runtime": {
    "model_id": "laya",
    "workstation_class": "CODESPACE_2VCPU_8GB",
    "persistent_profile_default": "baseline_2t",
    "profile_state_path": "~/.local/state/hazewave/reflex/latency/selected-profile.json",
    "loopback_port": 28080
  },
  "benchmark": {
    "warmup_requests": 2,
    "measured_requests": 7,
    "request_timeout_seconds": 10,
    "minimum_p50_improvement_fraction": 0.05,
    "maximum_p95_regression_fraction": 0.03,
    "require_same_selected_label": true,
    "require_all_robust_eligible": true,
    "require_zero_failures": true,
    "minimum_profiles": 2
  },
  "profiles": {
    "baseline_2t": {
      "persistent_eligible": true,
      "environment": {
        "OMP_NUM_THREADS": "2"
      }
    },
    "single_1t": {
      "persistent_eligible": true,
      "environment": {
        "OMP_NUM_THREADS": "1",
        "OMP_DYNAMIC": "FALSE"
      }
    },
    "close_2t": {
      "persistent_eligible": true,
      "environment": {
        "OMP_NUM_THREADS": "2",
        "OMP_DYNAMIC": "FALSE",
        "OMP_PROC_BIND": "close",
        "OMP_PLACES": "cores"
      }
    },
    "spread_2t": {
      "persistent_eligible": true,
      "environment": {
        "OMP_NUM_THREADS": "2",
        "OMP_DYNAMIC": "FALSE",
        "OMP_PROC_BIND": "spread",
        "OMP_PLACES": "cores"
      }
    },
    "passive_close_2t": {
      "persistent_eligible": true,
      "environment": {
        "OMP_NUM_THREADS": "2",
        "OMP_DYNAMIC": "FALSE",
        "OMP_PROC_BIND": "close",
        "OMP_PLACES": "cores",
        "OMP_WAIT_POLICY": "passive",
        "GOMP_SPINCOUNT": "0"
      }
    }
  },
  "safety": {
    "allowed_environment_keys": [
      "OMP_NUM_THREADS",
      "OMP_DYNAMIC",
      "OMP_PROC_BIND",
      "OMP_PLACES",
      "OMP_WAIT_POLICY",
      "GOMP_SPINCOUNT"
    ],
    "forbidden_automatic_optimizations": [
      "FAST_MATH",
      "INT8_LAYA",
      "QUESTION_ROTATION_REDUCTION",
      "STATE_TRUNCATION",
      "HEAD_TRUNCATION",
      "MODEL_REVISION_CHANGE",
      "ACTIVE_SPIN_DEFAULT"
    ],
    "selection_never_changes_model_outputs_contract": true,
    "selection_grants_production_authority": false,
    "automatic_model_or_threshold_promotion": false
  }
}
