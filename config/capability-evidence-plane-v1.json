      "bridge": "PYTHON",
      "constraints": [
        "AUTHORIZED_TIMELINE"
      ]
    },
    {
      "tool_id": "demucs",
      "version": "4.0.1",
      "domain": "HAZE",
      "capability_id": "audio.separate",
      "executable": "demucs",
