{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazewave.local/schemas/freellmapi-account-attestations-v1.schema.json",
  "title": "HazewaveProviderAccountAttestationStore/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "authority",
    "provider_gateway",
    "attestations"
  ],
  "properties": {
    "schema": {"const": "HazewaveProviderAccountAttestationStore/v1"},
    "project_id": {"const": "HAZEWAVE"},
    "authority": {"const": "HAZEWAVE_HARNESS"},
    "provider_gateway": {"const": "FREELLMAPI"},
    "attestations": {
      "type": "array",
      "items": {"$ref": "#/$defs/attestation"}
    }
  },
  "$defs": {
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_id",
        "provider",
        "credential_id",
        "account_tier",
        "paid_billing_enabled",
        "billing_overflow_policy",
        "evidence_method",
        "issued_at",
        "expires_at",
        "source_evidence"
      ],
      "properties": {
        "attestation_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "credential_id": {"type": "integer", "minimum": 1},
        "account_tier": {"const": "FREE"},
        "paid_billing_enabled": {"const": false},
        "billing_overflow_policy": {"const": "HARD_STOP"},
        "evidence_method": {
          "enum": [
            "HUMAN_VERIFIED_PROVIDER_ACCOUNT",
            "PROVIDER_ACCOUNT_API"
          ]
        },
        "issued_at": {"type": "string", "minLength": 10},
        "expires_at": {"type": "string", "minLength": 10},
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"}
      }
    }
  }
}
