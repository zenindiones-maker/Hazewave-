{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazewave.local/schemas/haze-state-v1.schema.json",
  "title": "HAZE State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state_id",
    "timestamp_ms",
    "source_id",
    "analysis_version",
    "fast",
    "meso",
    "macro",
    "confidence"
  ],
  "properties": {
    "schema": {
      "const": "HazeState/v1"
    },
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_version": {
      "type": "string",
      "minLength": 1
    },
    "fast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "energy",
        "transient_strength",
        "spectral_centroid_hz",
        "spectral_flux",
        "stereo_balance"
      ],
      "properties": {
        "energy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "transient_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "spectral_centroid_hz": {
          "type": "number",
          "minimum": 0
        },
        "spectral_flux": {
          "type": "number",
          "minimum": 0
        },
        "stereo_balance": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "meso": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tempo_bpm",
        "beat_phase",
        "harmonic_stability",
        "timbre_vector"
      ],
      "properties": {
        "tempo_bpm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 400
        },
        "beat_phase": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "harmonic_stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "timbre_vector": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        }
      }
    },
    "macro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "motif_id",
        "track_progress",
        "long_term_intensity"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "motif_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "track_progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "long_term_intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
