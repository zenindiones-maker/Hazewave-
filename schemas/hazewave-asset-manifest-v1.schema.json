{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazewave.local/schemas/hazewave-asset-manifest-v1.schema.json",
  "title": "Hazewave Asset Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "asset_id",
    "asset_type",
    "project_id",
    "work_id",
    "sources",
    "human_contributors",
    "ai_models",
    "tools",
    "operations",
    "rights_refs",
    "consent_refs",
    "artifact",
    "provenance_graph_ref",
    "content_credentials_ref",
    "human_approval",
    "publication_status"
  ],
  "properties": {
    "schema": {
      "const": "HazewaveAssetManifest/v1"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_type": {
      "enum": [
        "AUDIO",
        "MUSIC",
        "VOICE",
        "IMAGE",
        "VIDEO",
        "ANIMATION",
        "DOCUMENT",
        "DATASET",
        "SOFTWARE_BUILD",
        "OTHER"
      ]
    },
    "project_id": {
      "const": "HAZEWAVE"
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "human_contributors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/human"
      }
    },
    "ai_models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "rights_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "consent_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "provenance_graph_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_credentials_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_approval": {
      "$ref": "#/$defs/approval"
    },
    "publication_status": {
      "enum": [
        "DRAFT",
        "INTERNAL_REVIEW",
        "APPROVED",
        "RELEASED",
        "WITHDRAWN"
      ]
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256",
        "role"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "human": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contributor_id",
        "role"
      ],
      "properties": {
        "contributor_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "version",
        "purpose"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "type",
        "performed_by",
        "input_refs",
        "output_refs"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "performed_by": {
          "type": "string",
          "minLength": 1
        },
        "input_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "output_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "sha256",
        "mime_type"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
