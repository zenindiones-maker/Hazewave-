{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hazewave Reflex Latency Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","project_id","authority","provider_authority","activation_state","target_capability","runtime","benchmark","profiles","safety"],
  "properties": {
    "schema": {"const": "HazewaveReflexLatencyPolicy/v1"},
    "project_id": {"const": "HAZEWAVE"},
    "authority": {"const": "HAZEWAVE_HARNESS"},
    "provider_authority": {"const": "NONE"},
    "activation_state": {"const": "MEASURE_BEFORE_ACTIVATE"},
    "target_capability": {"const": "decision.route"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id","workstation_class","persistent_profile_default","profile_state_path","loopback_port"],
      "properties": {
        "model_id": {"const": "laya"},
        "workstation_class": {"type": "string","minLength": 1},
        "persistent_profile_default": {"type": "string","minLength": 1},
        "profile_state_path": {"type": "string","minLength": 1},
        "loopback_port": {"type": "integer","minimum": 1024,"maximum": 65535}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_requests","measured_requests","request_timeout_seconds","minimum_p50_improvement_fraction","maximum_p95_regression_fraction","require_same_selected_label","require_all_robust_eligible","require_zero_failures","minimum_profiles"],
      "properties": {
        "warmup_requests": {"type": "integer","minimum": 1,"maximum": 20},
        "measured_requests": {"type": "integer","minimum": 3,"maximum": 50},
        "request_timeout_seconds": {"type": "number","minimum": 3,"maximum": 60},
        "minimum_p50_improvement_fraction": {"type": "number","minimum": 0,"maximum": 0.5},
        "maximum_p95_regression_fraction": {"type": "number","minimum": 0,"maximum": 0.5},
        "require_same_selected_label": {"const": true},
        "require_all_robust_eligible": {"const": true},
        "require_zero_failures": {"const": true},
        "minimum_profiles": {"type": "integer","minimum": 2,"maximum": 10}
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["persistent_eligible","environment"],
        "properties": {
          "persistent_eligible": {"type": "boolean"},
          "environment": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_environment_keys","forbidden_automatic_optimizations","selection_never_changes_model_outputs_contract","selection_grants_production_authority","automatic_model_or_threshold_promotion"],
      "properties": {
        "allowed_environment_keys": {"type": "array","minItems": 1,"items": {"type": "string","minLength": 1}},
        "forbidden_automatic_optimizations": {"type": "array","minItems": 1,"items": {"type": "string","minLength": 1}},
        "selection_never_changes_model_outputs_contract": {"const": true},
        "selection_grants_production_authority": {"const": false},
        "automatic_model_or_threshold_promotion": {"const": false}
      }
    }
  }
}
