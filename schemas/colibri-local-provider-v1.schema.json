{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hazewave.local/schemas/colibri-local-provider-v1.schema.json",
  "title": "Hazewave Colibri Local Provider Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","project_id","authority","provider","provider_authority","trust_lane","upstream","transport","runtime_policy","resource_policy","data_policy","decision_policy","models"],
  "properties": {
    "schema": {"const": "HazewaveColibriLocalProviderPolicy/v1"},
    "project_id": {"const": "HAZEWAVE"},
    "authority": {"const": "HAZEWAVE_HARNESS"},
    "provider": {"const": "colibri"},
    "provider_authority": {"const": "NONE"},
    "trust_lane": {"const": "LOCAL_PRIVATE"},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository","release_tag","source_commit","engine_license","linux_x86_64_release_sha256"],
      "properties": {
        "repository": {"const": "JustVugg/colibri"},
        "release_tag": {"type": "string","minLength": 1},
        "source_commit": {"type": "string","pattern": "^[0-9a-f]{40}$"},
        "engine_license": {"const": "Apache-2.0"},
        "linux_x86_64_release_sha256": {"type": "string","pattern": "^[0-9a-f]{64}$"}
      }
    },
    "transport": {
      "type": "object","additionalProperties": false,
      "required": ["base_url","loopback_only","api_key_required","external_bind_forbidden"],
      "properties": {
        "base_url": {"const": "http://127.0.0.1:28080"},
        "loopback_only": {"const": true},
        "api_key_required": {"const": true},
        "external_bind_forbidden": {"const": true}
      }
    },
    "runtime_policy": {
      "type": "object","additionalProperties": false,
      "required": ["role","decision_authority","auto_install","auto_download","paid_fallback","unknown_cost","raw_media_ingress","mcp_install_authority","security_or_promotion_self_approval"],
      "properties": {
        "role": {"const": "SUBORDINATE_LOCAL_EXECUTION_PROVIDER"},
        "decision_authority": {"const": "ADVISORY_ONLY"},
        "auto_install": {"const": false},
        "auto_download": {"const": false},
        "paid_fallback": {"const": "FORBIDDEN"},
        "unknown_cost": {"const": "DENY"},
        "raw_media_ingress": {"const": false},
        "mcp_install_authority": {"const": "FORBIDDEN"},
        "security_or_promotion_self_approval": {"const": false}
      }
    },
    "resource_policy": {
      "type": "object","additionalProperties": false,
      "required": ["reserve_system_ram_gb","runtime_headroom_ram_gb","reserve_disk_gb","current_workstation_lane"],
      "properties": {
        "reserve_system_ram_gb": {"type":"number","minimum":1},
        "runtime_headroom_ram_gb": {"type":"number","minimum":0.5},
        "reserve_disk_gb": {"type":"number","minimum":2},
        "current_workstation_lane": {"const":"DECISION_ONLY"}
      }
    },
    "data_policy": {
      "type":"object","additionalProperties":false,
      "required":["allowed_classes","forbidden_classes"],
      "properties":{
        "allowed_classes":{"type":"array","uniqueItems":true,"items":{"enum":["PUBLIC","INTERNAL_NON_SECRET","PRIVATE_MEDIA"]}},
        "forbidden_classes":{"type":"array","uniqueItems":true,"contains":{"const":"CREDENTIAL"},"items":{"enum":["CREDENTIAL"]}}
      }
    },
    "decision_policy": {
      "type":"object","additionalProperties":false,
      "required":["min_choice_confidence","low_confidence_action","direct_human_language","pt_br_direct_classification","may_expand_harness_authority"],
      "properties":{
        "min_choice_confidence":{"type":"number","minimum":0,"maximum":1},
        "low_confidence_action":{"const":"FAIL_CLOSED_OR_DEFER_TO_EXISTING_HARNESS_RULE"},
        "direct_human_language":{"const":"en"},
        "pt_br_direct_classification":{"const":"NOT_QUALIFIED"},
        "may_expand_harness_authority":{"const":false}
      }
    },
    "models": {
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","api_model","mode","repository","revision","primary_weight_sha256","download_gb","ram_min_gb","ram_good_gb","license","languages","allowed_capabilities","execution_enabled","production_allowed","recommended_current_tier"],
        "properties":{
          "id":{"type":"string","minLength":1},
          "api_model":{"type":"string","minLength":1},
          "mode":{"const":"decision"},
          "repository":{"type":"string","minLength":3},
          "revision":{"type":"string","pattern":"^[0-9a-f]{7,40}$"},
          "primary_weight_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "download_gb":{"type":"number","exclusiveMinimum":0},
          "ram_min_gb":{"type":"number","exclusiveMinimum":0},
          "ram_good_gb":{"type":"number","exclusiveMinimum":0},
          "license":{"type":"string","minLength":1},
          "languages":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":2}},
          "allowed_capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["decision.route","decision.gate","decision.score"]}},
          "execution_enabled":{"type":"boolean"},
          "production_allowed":{"type":"boolean"},
          "recommended_current_tier":{"type":"boolean"}
        }
      }
    }
  }
}
